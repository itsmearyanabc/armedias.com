---
// Small looping line icons for feature cards. Each has one moving part so a grid of cards
// feels alive without being busy; motion speeds up while the card is hovered.
type Name =
  | 'layers' | 'founder' | 'receipt' | 'key' | 'clock' | 'bolt' | 'target' | 'chat' | 'sparkle'
  | 'handshake' | 'demo' | 'board' | 'lock' | 'rocket' | 'stack' | 'mentor' | 'home';

interface Props { name: Name; class?: string }
const { name, class: className } = Astro.props;
---

<span class:list={['aicon', className]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {name === 'layers' && <>
      <path class="a-up" d="M12 3l9 5-9 5-9-5z" /><path d="M3 13l9 5 9-5" /><path class="a-fade" d="M3 17.5l9 5 9-5" />
    </>}
    {name === 'founder' && <>
      <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /><path class="a-spin" d="M19 2l.8 1.7 1.7.8-1.7.8L19 7l-.8-1.7-1.7-.8 1.7-.8z" fill="currentColor" />
    </>}
    {name === 'receipt' && <>
      <path d="M6 2h12v20l-3-2-3 2-3-2-3 2z" /><path class="a-draw" d="M9 7h6M9 11h6M9 15h3" />
    </>}
    {name === 'key' && <>
      <g class="a-turn"><circle cx="8" cy="15" r="4" /><path d="M11 12l9-9M17 6l2 2M15 8l2 2" /></g>
    </>}
    {name === 'clock' && <>
      <circle cx="12" cy="12" r="9" /><path class="a-hand" d="M12 12V7" /><path class="a-hand-slow" d="M12 12h4" />
    </>}
    {name === 'bolt' && <>
      <path class="a-flash" d="M13 2L4 14h7l-1 8 9-12h-7z" />
    </>}
    {name === 'target' && <>
      <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle class="a-ping" cx="12" cy="12" r="1.6" fill="currentColor" />
    </>}
    {name === 'chat' && <>
      <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z" /><g fill="currentColor" stroke="none"><circle class="a-dot" cx="8.5" cy="12" r="1.1" /><circle class="a-dot d2" cx="12" cy="12" r="1.1" /><circle class="a-dot d3" cx="15.5" cy="12" r="1.1" /></g>
    </>}
    {name === 'sparkle' && <>
      <path class="a-pulse" d="M12 3l2.2 6.8L21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z" /><path class="a-spin" d="M19 2v4M17 4h4" />
    </>}
    {name === 'handshake' && <>
      <path d="M2 12l4-4 4 2 4-3 4 2 4 3" /><path class="a-shake" d="M6 13l4 4 2-1 2 2 2-1 3-3" /><path d="M2 12v4M22 12v4" />
    </>}
    {name === 'demo' && <>
      <rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /><path class="a-pulse" d="M10 8.5v5l4.5-2.5z" fill="currentColor" />
    </>}
    {name === 'board' && <>
      <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 4v16" /><rect class="a-slide" x="4.5" y="7" width="3" height="3" rx="0.6" fill="currentColor" stroke="none" />
    </>}
    {name === 'lock' && <>
      <rect x="4" y="11" width="16" height="10" rx="2" /><path class="a-shackle" d="M8 11V7a4 4 0 0 1 8 0v4" /><circle cx="12" cy="16" r="1.4" fill="currentColor" />
    </>}
    {name === 'rocket' && <>
      <g class="a-launch"><path d="M14 4c4 1 6 5 5 9l-3 3-5-5 3-7z" /><circle cx="15.5" cy="8.5" r="1.4" /><path d="M11 11l-3 1 1-3" /></g><path class="a-flame" d="M8 16l-3 3M10 18l-2 3" />
    </>}
    {name === 'stack' && <>
      <rect class="a-up" x="4" y="3" width="16" height="5" rx="1.5" /><rect x="4" y="10" width="16" height="5" rx="1.5" /><rect x="4" y="17" width="16" height="4" rx="1.5" />
    </>}
    {name === 'mentor' && <>
      <circle cx="8" cy="8" r="3" /><path d="M2 20a6 6 0 0 1 12 0" /><circle class="a-up" cx="17" cy="10" r="2.3" /><path d="M13.5 20a4 4 0 0 1 7.5-1.5" />
    </>}
    {name === 'home' && <>
      <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" /><path class="a-fade" d="M18 3v4" />
    </>}
  </svg>
</span>

<style>
  .aicon { display: inline-grid; place-items: center; }
  .aicon svg { width: 100%; height: 100%; overflow: visible; }
  .aicon :is(.a-up, .a-spin, .a-turn, .a-pulse, .a-flash, .a-ping, .a-dot, .a-shake, .a-slide, .a-shackle, .a-launch, .a-hand, .a-hand-slow) {
    transform-box: fill-box; transform-origin: center;
  }
  .a-up { animation: a-up 2.4s ease-in-out infinite; }
  .a-fade { animation: a-fade 2.4s ease-in-out infinite; }
  .a-spin { animation: a-spin 6s linear infinite; }
  .a-draw { stroke-dasharray: 20; animation: a-draw 3s ease-in-out infinite; }
  .a-turn { transform-origin: 8px 15px; transform-box: view-box; animation: a-turn 3s ease-in-out infinite; }
  .a-hand { transform-origin: 12px 12px; transform-box: view-box; animation: a-spin 4s linear infinite; }
  .a-hand-slow { transform-origin: 12px 12px; transform-box: view-box; animation: a-spin 24s linear infinite; }
  .a-flash { animation: a-flash 2.2s ease-in-out infinite; }
  .a-ping { animation: a-ping 1.8s ease-out infinite; }
  .a-dot { animation: a-dot 1.2s ease-in-out infinite; } .d2 { animation-delay: 0.15s; } .d3 { animation-delay: 0.3s; }
  .a-pulse { animation: a-pulse 2s ease-in-out infinite; }
  .a-shake { animation: a-shake 2.4s ease-in-out infinite; }
  .a-slide { animation: a-slide 3.2s ease-in-out infinite; }
  .a-shackle { animation: a-shackle 3s ease-in-out infinite; }
  .a-launch { animation: a-launch 2.6s ease-in-out infinite; }
  .a-flame { stroke-dasharray: 6; animation: a-draw 0.8s linear infinite; }

  /* Faster while the surrounding card is hovered */
  :global(.group:hover) .aicon * { animation-duration: 0.9s; }

  @keyframes a-up { 50% { transform: translateY(-2px); } }
  @keyframes a-fade { 50% { opacity: 0.25; } }
  @keyframes a-spin { to { transform: rotate(360deg); } }
  @keyframes a-draw { 0% { stroke-dashoffset: 20; } 50%, 100% { stroke-dashoffset: 0; } }
  @keyframes a-turn { 0%, 30% { transform: rotate(0); } 60%, 100% { transform: rotate(-35deg); } }
  @keyframes a-flash { 0%, 100% { opacity: 1; transform: scale(1); } 10% { opacity: 0.4; } 20% { opacity: 1; transform: scale(1.12); } }
  @keyframes a-ping { from { transform: scale(0.6); } 50% { transform: scale(1.4); } to { transform: scale(0.6); } }
  @keyframes a-dot { 50% { transform: translateY(-2px); opacity: 0.4; } }
  @keyframes a-pulse { 50% { transform: scale(1.15); } }
  @keyframes a-shake { 25% { transform: translateY(-1px) rotate(-3deg); } 75% { transform: translateY(1px) rotate(3deg); } }
  @keyframes a-slide { 0%, 15% { transform: translateX(0); } 45%, 60% { transform: translateX(6px); } 90%, 100% { transform: translateX(12px); opacity: 0; } }
  @keyframes a-shackle { 0%, 40%, 100% { transform: translateY(0); } 60%, 80% { transform: translateY(-2px); } }
  @keyframes a-launch { 50% { transform: translate(1.5px, -1.5px); } }
  @media (prefers-reduced-motion: reduce) { .aicon * { animation: none !important; } }
</style>
