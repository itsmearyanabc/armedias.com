---
// Small white chips that slide in around a hero visual and then float gently, like the
// notification card on the share images. Each chip states a plain fact about working with us.
// Decorative layout only: the same facts appear in the page text. Under reduced motion the
// chips simply sit still. Parent must be `relative`.
interface Chip { text: string; sub?: string; icon: 'check' | 'clock' | 'quote' | 'key' }
interface Props { chips: Chip[] }
const { chips } = Astro.props;
const icons = {
  check: 'M6 12.5l4 4 8-9',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  quote: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5',
  key: 'M14 10a4 4 0 1 1-1.2-2.8L21 15v3h-3v-2h-2v-2h-2.2',
};
---

<ul class="hero-chips" aria-hidden="true">
  {chips.map((c, i) => (
    <li class={`hero-chip hero-chip--${i}`} style={`--i:${i}`}>
      <span class={`hero-chip__icon hero-chip__icon--${c.icon}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={icons[c.icon]} /></svg>
      </span>
      <span>
        <span class="hero-chip__text">{c.text}</span>
        {c.sub && <span class="hero-chip__sub">{c.sub}</span>}
      </span>
    </li>
  ))}
</ul>

<style>
  .hero-chips { position: absolute; inset: 0; pointer-events: none; }
  .hero-chip {
    position: absolute; display: flex; align-items: center; gap: 0.7rem; white-space: nowrap;
    border-radius: 1rem; background: #fff; padding: 0.7rem 1rem 0.7rem 0.75rem;
    box-shadow: 0 0 0 1px rgb(19 33 58 / 0.06), 0 14px 30px -12px rgb(19 33 58 / 0.3);
    animation: chip-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.5s + var(--i) * 0.25s) backwards,
               chip-float 6s ease-in-out calc(1.4s + var(--i) * 0.8s) infinite alternate;
  }
  .hero-chip--0 { left: -1.5rem; top: 52%; }
  .hero-chip--1 { right: -1.25rem; top: -1.25rem; }
  .hero-chip--2 { right: 8%; bottom: -3.25rem; }
  .hero-chip__icon { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 999px; color: #fff; }
  .hero-chip__icon--check { background: #25d366; }
  .hero-chip__icon--clock { background: var(--color-navy); }
  .hero-chip__icon--quote { background: var(--color-ember); color: var(--color-navy); }
  .hero-chip__icon--key { background: var(--color-olive); }
  .hero-chip__text { display: block; font-size: 0.875rem; font-weight: 700; color: var(--color-navy); }
  .hero-chip__sub { display: block; font-size: 0.75rem; color: var(--color-slate); }
  @keyframes chip-in { from { opacity: 0; transform: translateY(16px) scale(0.9); } }
  @keyframes chip-float { to { transform: translateY(-8px); } }
  /* Phones: one chip only, tucked under the visual, so nothing covers the map */
  @media (max-width: 40rem) {
    .hero-chip--1, .hero-chip--2 { display: none; }
    .hero-chip--0 { left: 0.75rem; top: auto; bottom: -1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-chip { animation: none; } }
</style>
