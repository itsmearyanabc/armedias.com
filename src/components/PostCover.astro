---
// Animated, image-free cover art per category: a gradient field with the category's
// icon and floating shapes. Weighs nothing and never looks like stock photography.
import { categories } from '../content.config';

interface Props { category: keyof typeof categories; class?: string }
const { category, class: className } = Astro.props;

const art = {
  crm: { bg: 'from-navy to-navy-700', icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75' },
  erp: { bg: 'from-olive to-navy', icon: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z' },
  'ai-automation': { bg: 'from-navy-700 to-olive', icon: 'M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z' },
  'web-apps': { bg: 'from-olive-500 to-navy-700', icon: 'M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01' },
}[category];
---

<div aria-hidden="true" class:list={['cover relative overflow-hidden bg-gradient-to-br', art.bg, className]}>
  <span class="shape absolute -left-6 top-6 size-24 rounded-3xl border border-white/15"></span>
  <span class="shape shape--2 absolute bottom-4 right-10 size-16 rounded-full bg-olive-300/25"></span>
  <span class="shape shape--3 absolute right-1/4 top-8 size-10 rounded-xl bg-white/10"></span>
  <div class="absolute inset-0 grid place-items-center">
    <span class="grid size-20 place-items-center rounded-3xl bg-white/10 text-olive-300 ring-1 ring-white/20 backdrop-blur-sm transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={art.icon} /></svg>
    </span>
  </div>
</div>

<style>
  .cover { min-height: 12rem; }
  .shape { animation: float 7s ease-in-out infinite alternate; }
  .shape--2 { animation-duration: 9s; animation-delay: -2s; }
  .shape--3 { animation-duration: 6s; animation-delay: -4s; }
  @keyframes float { to { transform: translate(14px, -16px) rotate(18deg); } }
</style>
