---
// Animated, image-free cover art per category: a gradient field with floating shapes and
// the matching service illustration. Weighs nothing and never looks like stock photography.
import { categories } from '../content.config';
import Illustration from './illustrations/Illustration.astro';

interface Props { category: keyof typeof categories; class?: string }
const { category, class: className } = Astro.props;

const art = {
  crm: { bg: 'from-navy to-navy-700', scene: 'crm-development' },
  erp: { bg: 'from-olive to-navy', scene: 'erp-development' },
  'ai-automation': { bg: 'from-navy-700 to-olive', scene: 'ai-automation' },
  'web-apps': { bg: 'from-olive-500 to-navy-700', scene: 'website-development' },
}[category] as { bg: string; scene: 'crm-development' | 'erp-development' | 'ai-automation' | 'website-development' };
---

<div aria-hidden="true" class:list={['cover relative overflow-hidden bg-gradient-to-br', art.bg, className]}>
  <span class="shape absolute -left-6 top-6 size-24 rounded-3xl border border-white/15"></span>
  <span class="shape shape--2 absolute bottom-4 right-10 size-16 rounded-full bg-olive-300/25"></span>
  <span class="shape shape--3 absolute right-1/4 top-8 size-10 rounded-xl bg-white/10"></span>
  <div class="absolute inset-0 flex items-center justify-center p-3">
    <div class="aspect-[4/3] h-full transition-transform duration-500 group-hover:scale-105">
      <Illustration name={art.scene} title={categories[category]} />
    </div>
  </div>
</div>

<style>
  .shape { animation: float 7s ease-in-out infinite alternate; }
  .shape--2 { animation-duration: 9s; animation-delay: -2s; }
  .shape--3 { animation-duration: 6s; animation-delay: -4s; }
  @keyframes float { to { transform: translate(14px, -16px) rotate(18deg); } }
</style>
