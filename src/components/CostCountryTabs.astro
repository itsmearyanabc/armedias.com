---
// Market prices by country for a cost guide. Without JavaScript every country is listed in
// full; with it, the list becomes tabs that open on the visitor's country (from the URL hash,
// for links like /pricing/website-development-cost/#usa, or their time zone).
import Flag from './Flag.astro';
import { markets, site } from '../data/site';
import type { CostGuide, CostTier, MarketCost } from '../data/cost-guides';
import { priceText } from '../lib/cost-format';

interface Props { guide: CostGuide }
const { guide } = Astro.props;

const info = (slug: string) => {
  const m = markets.find((x) => x.slug === slug);
  if (!m) throw new Error(`Unknown market ${slug}`);
  return m;
};
// Bars share one log scale per country, so a row's position shows where it sits in that market.
const scale = (m: MarketCost) => {
  const lo = Math.min(...m.tiers.map((t) => t.min));
  const hi = Math.max(...m.tiers.map((t) => t.max ?? t.min * 4));
  const pos = (n: number) => ((Math.log(n) - Math.log(lo)) / (Math.log(hi) - Math.log(lo))) * 100;
  return (t: CostTier) => {
    const left = pos(t.min);
    const right = t.max === undefined ? 100 : pos(t.max);
    return { left: Math.min(left, 96), width: Math.max(right - left, 4) };
  };
};
const currencyName = (code: string) => new Intl.DisplayNames('en', { type: 'currency' }).of(code) ?? code;
const askText = (country: string) => `Hi AR Medias, I'm in ${country} and I'm planning a website. My budget is: `;
---

<section id="prices" class="scroll-mt-24 py-24" data-cost-tabs>
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow" data-reveal="fade">Prices by country</p>
      <h2 class="mt-4 text-4xl font-bold sm:text-5xl">What a website costs where you are.</h2>
      <p class="mt-5 text-lg text-slate" data-reveal="up">Pick your country. Prices are in local currency and come from the published guides named under each table, checked on {guide.checked}. They are market figures, not our prices.</p>
    </div>

    <div role="tablist" aria-label="Choose a country" class="cost-tablist mt-10 hidden flex-wrap gap-2" data-tablist>
      {guide.markets.map((m, i) => {
        const mi = info(m.slug);
        return (
          <button type="button" role="tab" id={`tab-${m.slug}`} aria-controls={m.slug} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={m.slug}
            class="cost-tab inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold ring-1 ring-navy/10 transition-colors">
            <Flag code={mi.code} class="h-3.5 w-5" />{mi.country}
          </button>
        );
      })}
    </div>

    <div class="mt-8 space-y-10" data-panels>
      {guide.markets.map((m) => {
        const mi = info(m.slug);
        const bar = m.tiers.length ? scale(m) : null;
        return (
          <article id={m.slug} role="tabpanel" aria-labelledby={`tab-${m.slug}`} data-panel={m.slug} class="cost-panel scroll-mt-28 overflow-hidden rounded-[2rem] bg-white ring-1 ring-navy/8">
            <header class="flex flex-wrap items-center justify-between gap-4 border-b border-navy/8 bg-mist/60 px-6 py-5 sm:px-9">
              <h3 class="flex items-center gap-3 font-display text-2xl font-bold">
                <Flag code={mi.code} class="h-5 w-7" />Website prices in {mi.country}
              </h3>
              {m.currency && <span class="rounded-full bg-navy px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">{currencyName(m.currency)} · {m.currency}</span>}
            </header>
            <div class="px-6 py-8 sm:px-9">
              <p class="max-w-3xl text-lg leading-relaxed text-slate">{m.intro}</p>

              {m.tiers.length > 0 && (
                <table class="mt-8 block w-full text-left sm:table sm:border-separate sm:border-spacing-y-2">
                  <caption class="sr-only">Market price ranges for websites in {mi.country}</caption>
                  <thead class="sr-only"><tr><th scope="col">Type of website</th><th scope="col">Market price range</th></tr></thead>
                  <tbody class="block space-y-2 sm:table-row-group sm:space-y-0">
                    {m.tiers.map((t) => {
                      const b = bar ? bar(t) : { left: 0, width: 0 };
                      const fill = () => <span aria-hidden="true" class="cost-track relative mt-3 block h-2 rounded-full bg-navy/8">
                        <span class={`cost-fill absolute inset-y-0 rounded-full ${t.max === undefined || t.plus ? 'cost-fill--open' : ''}`} style={`left:${b.left.toFixed(1)}%;width:${b.width.toFixed(1)}%`}></span>
                      </span>;
                      return (
                        <tr class="cost-row flex flex-col rounded-2xl bg-mist/50 sm:table-row sm:bg-transparent sm:align-top" data-tier={t.key}>
                          <th scope="row" class="block px-5 pt-4 font-normal sm:table-cell sm:w-full sm:rounded-l-2xl sm:bg-mist/50 sm:py-4 sm:pr-4">
                            <span class="block font-display text-lg font-semibold text-navy">{t.label}</span>
                            <span class="block text-sm text-slate">{t.detail} <sup class="text-[0.65rem] text-slate/80">[{t.source + 1}]</sup></span>
                            <span class="hidden sm:block">{fill()}</span>
                          </th>
                          <td class="block px-5 pb-4 pt-1 font-display text-lg font-bold text-navy sm:table-cell sm:whitespace-nowrap sm:rounded-r-2xl sm:bg-mist/50 sm:py-4 sm:pl-2 sm:pr-5 sm:text-right">
                            {priceText(t, m)}
                            <span class="block sm:hidden">{fill()}</span>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              )}

              {m.notes && (
                <ul class="mt-8 grid gap-3 sm:grid-cols-2">
                  {m.notes.map((n) => (
                    <li class="flex gap-3 rounded-2xl bg-mist/60 p-5 text-slate"><span class="mt-2 size-2 shrink-0 rounded-full bg-ember"></span>{n}</li>
                  ))}
                </ul>
              )}

              {(m.highlight || m.timeline || m.ongoing.length > 0) && (
                <div class="mt-8 grid gap-4 lg:grid-cols-3">
                  {m.ongoing.length > 0 && (
                    <div class="rounded-2xl bg-navy p-6 text-white lg:col-span-1">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember-300">After launch</p>
                      <dl class="mt-3 space-y-2 text-sm">
                        {m.ongoing.map((o) => <div class="flex justify-between gap-4"><dt class="text-white/70">{o.label}</dt><dd class="text-right font-semibold">{o.value} <sup class="text-[0.6rem] text-white/50">[{o.source + 1}]</sup></dd></div>)}
                      </dl>
                    </div>
                  )}
                  {m.timeline && (
                    <div class="rounded-2xl bg-olive/10 p-6">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-olive">Timeline</p>
                      <p class="mt-3 text-navy">{m.timeline.text} <sup class="text-[0.6rem] text-slate">[{m.timeline.source + 1}]</sup></p>
                    </div>
                  )}
                  {m.highlight && (
                    <div class="rounded-2xl bg-ember/10 p-6">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember-700">Worth knowing</p>
                      <p class="mt-3 text-navy">{m.highlight.text} <sup class="text-[0.6rem] text-slate">[{m.highlight.source + 1}]</sup></p>
                    </div>
                  )}
                </div>
              )}

              <div class="mt-8 flex flex-col gap-4 rounded-2xl border-2 border-dashed border-olive/30 p-6 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-navy"><span class="font-display text-lg font-bold">Budget lower than this?</span> Tell us what you have to spend. We'll suggest what fits it.</p>
                <a href={`${site.whatsapp}?text=${encodeURIComponent(askText(mi.country))}`} target="_blank" rel="noopener nofollow" class="btn-ember shrink-0" data-wa>Share my budget on WhatsApp</a>
              </div>

              {m.sources.length > 0 && (
                <ol class="mt-6 space-y-1 text-xs text-slate">
                  {m.sources.map((s, i) => (
                    <li>[{i + 1}] {s.publisher}, <a href={s.url} target="_blank" rel="nofollow noopener" class="underline decoration-navy/20 underline-offset-2 hover:text-olive">{s.title}</a> ({s.date})</li>
                  ))}
                </ol>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .cost-fill { background: linear-gradient(90deg, var(--color-olive), var(--color-ember)); transform-origin: left; transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cost-fill--open { background: linear-gradient(90deg, var(--color-olive), var(--color-ember) 70%, rgb(255 122 26 / 0)); }
  :global(.js-cost) .cost-panel:not(.is-in) .cost-fill { transform: scaleX(0); }
  .cost-tab[aria-selected='true'] { background: var(--color-navy); color: #fff; }
  .cost-tab[aria-selected='false'] { background: #fff; color: var(--color-navy); }
  .cost-tab[aria-selected='false']:hover { background: var(--color-mist); }
  @media (prefers-reduced-motion: reduce) { .cost-fill { transition: none; } }
</style>

<script>
  // Tabs: progressive enhancement over the full list above.
  const ZONES: Record<string, string> = {
    'Asia/Kolkata': 'india', 'Asia/Calcutta': 'india', 'Asia/Dubai': 'uae', 'Asia/Tokyo': 'japan',
    'Asia/Shanghai': 'china', 'Asia/Hong_Kong': 'china', 'Europe/Moscow': 'russia',
  };
  function guessCountry(available: string[]): string | null {
    const hash = location.hash.slice(1);
    if (available.includes(hash)) return hash;
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone ?? '';
    const zone = ZONES[tz];
    if (zone && available.includes(zone)) return zone;
    if (tz.startsWith('Australia/') && available.includes('australia')) return 'australia';
    if (/^America\/(Toronto|Vancouver|Edmonton|Winnipeg|Halifax|Regina|St_Johns)/.test(tz) && available.includes('canada')) return 'canada';
    if (tz.startsWith('America/') && available.includes('usa')) return 'usa';
    return null;
  }

  document.querySelectorAll<HTMLElement>('[data-cost-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!tabs.length) return;
    document.documentElement.classList.add('js-cost');
    root.querySelector('[data-tablist]')?.classList.remove('hidden');
    root.querySelector('[data-tablist]')?.classList.add('flex');

    const select = (slug: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === slug;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === slug;
        p.hidden = !on;
        if (on) requestAnimationFrame(() => requestAnimationFrame(() => p.classList.add('is-in')));
      });
      document.dispatchEvent(new CustomEvent('cost:country', { detail: slug }));
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        select(t.dataset.tab!);
        history.replaceState(null, '', `#${t.dataset.tab}`);
      });
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });
    document.addEventListener('cost:pick', (e) => select((e as CustomEvent<string>).detail));

    const slugs = tabs.map((t) => t.dataset.tab!);
    select(guessCountry(slugs) ?? slugs[0]);
    window.addEventListener('hashchange', () => {
      const slug = location.hash.slice(1);
      if (slugs.includes(slug)) select(slug);
    });
  });
</script>
