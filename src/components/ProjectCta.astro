---
// Closing call to action for location pages. Delhi pages keep the office address and
// directions; city pages outside Delhi NCR pass their own body and hide the address.
import RouteBackdrop from './RouteBackdrop.astro';
import Spotlight from './Spotlight.astro';
import { site } from '../data/site';

interface Props { heading: string; body?: string; showAddress?: boolean }
const {
  heading,
  body = 'Free 30-minute call, on Google Meet or at our Kirti Nagar office. You leave with a clear plan, timeline and fixed price.',
  showAddress = true,
} = Astro.props;
const mapQuery = encodeURIComponent(`AR Medias, ${site.address.street}, ${site.address.locality}, ${site.address.countryName}`);
---

<section class="container-x py-24">
  <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-navy via-[#1f3d2a] to-olive px-8 py-16 text-center text-white sm:px-16 lg:py-20" data-reveal="up">
    <RouteBackdrop />
    <div aria-hidden="true" class="blob pointer-events-none absolute -right-20 -top-20 size-80 rounded-full bg-ember/35 blur-3xl"></div>
    <Spotlight tone="sun" x="50%" y="40%" />
    <h2 class="relative mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl">{heading}</h2>
    <p class="relative mx-auto mt-5 max-w-xl text-lg text-white/85">{body}</p>
    <div class="relative mt-9 flex flex-wrap justify-center gap-3">
      <a href="/contact/" class="btn-ember" data-magnetic>Book a free call</a>
      <a href={site.whatsapp} class="btn border-2 border-white/40 text-white hover:border-white" rel="noopener" target="_blank">WhatsApp us</a>
    </div>
    {showAddress && <p class="relative mt-8 text-sm text-white/70">{site.address.street}, {site.address.locality} {site.address.postalCode} · <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} class="font-semibold text-ember-300 hover:text-white" rel="noopener" target="_blank">Get directions →</a></p>}
  </div>
</section>
