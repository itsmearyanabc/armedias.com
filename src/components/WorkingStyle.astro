---
// How we work with clients: meetings, follow-ups and billing. Delhi pages use the
// default list; country pages pass their own.
import Spotlight from './Spotlight.astro';
import { delhiWorkingStyle } from '../data/delhi';

interface Props { items?: { t: string; d: string; icon: string }[]; heading?: string }
const { items = delhiWorkingStyle, heading = 'Meet in person, stay updated, never chase us.' } = Astro.props;
---

<section aria-labelledby="working-style-heading" class="relative overflow-hidden bg-navy py-24 text-white lg:py-28">
  <div aria-hidden="true" class="blob pointer-events-none absolute -left-40 top-1/3 size-[30rem] rounded-full bg-olive/25 blur-3xl"></div>
  <div aria-hidden="true" class="blob pointer-events-none absolute -right-32 -top-24 size-[26rem] rounded-full bg-ember/10 blur-3xl"></div>
  <Spotlight grid x="75%" y="25%" />
  <div class="container-x relative">
    <div class="max-w-2xl" data-reveal="up">
      <p class="eyebrow text-ember-300!">How we work with you</p>
      <h2 id="working-style-heading" class="mt-4 text-4xl font-bold text-white sm:text-5xl">{heading}</h2>
    </div>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
      {items.map((w) => (
        <li class="group rounded-3xl bg-white/[0.04] p-6 ring-1 ring-white/10 backdrop-blur-sm transition-colors duration-300 hover:bg-white/[0.08] hover:ring-ember/50 sm:p-7">
          <span class="grid size-12 place-items-center rounded-2xl bg-ember text-navy transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={w.icon} /></svg>
          </span>
          <h3 class="mt-5 text-xl font-bold text-white">{w.t}</h3>
          <p class="mt-2 leading-relaxed text-white/70">{w.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
