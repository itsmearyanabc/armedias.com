---
// The lead form. Used on /contact/ and in the contact section at the end of every page,
// so it handles any number of instances on a page.
import { site, markets } from '../data/site';
import { services } from '../data/services';

interface Props { title?: string }
const { title = 'Get a free quote' } = Astro.props;
const budgets = ['Under $2,000', '$2,000 – $5,000', '$5,000 – $15,000', '$15,000 – $50,000', '$50,000+', 'Not sure yet'];
---

<div class="relative">
  <form data-contact-form action="/api/contact/" method="post" class="relative rounded-[2rem] bg-white p-7 shadow-2xl shadow-navy/10 ring-1 ring-navy/5 sm:p-10" novalidate>
    <h2 class="text-2xl font-bold sm:text-3xl" data-no-split>{title}</h2>
    <p class="mt-2 text-slate">Fields marked * are required.</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <label class="field">
        <span>Full name *</span>
        <input name="name" required autocomplete="name" maxlength="100" />
      </label>
      <label class="field">
        <span>Work email *</span>
        <input name="email" type="email" required autocomplete="email" maxlength="150" />
      </label>
      <label class="field">
        <span>Phone / WhatsApp</span>
        <input name="phone" type="tel" autocomplete="tel" maxlength="30" />
      </label>
      <label class="field">
        <span>Company</span>
        <input name="company" autocomplete="organization" maxlength="120" />
      </label>
      <label class="field">
        <span>Service *</span>
        <select name="service" required>
          <option value="">Choose a service</option>
          {services.map((s) => <option>{s.name}</option>)}
          <option>Not sure yet</option>
        </select>
      </label>
      <label class="field">
        <span>Country *</span>
        <select name="country" required>
          <option value="">Choose a country</option>
          {markets.map((m) => <option>{m.country}</option>)}
          <option>Other</option>
        </select>
      </label>
      <label class="field sm:col-span-2">
        <span>Budget</span>
        <select name="budget">
          <option value="">Select a range (optional)</option>
          {budgets.map((b) => <option>{b}</option>)}
        </select>
      </label>
      <label class="field sm:col-span-2">
        <span>Tell us about your project *</span>
        <textarea name="message" rows="5" required maxlength="5000" placeholder="What do you want to build, and what problem should it solve?"></textarea>
      </label>
      <!-- Honeypot: hidden from people, filled by bots -->
      <label class="absolute -left-[9999px]" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <p class="mt-5 text-sm text-slate">By sending this form you agree to our <a href="/privacy-policy/" class="font-semibold text-olive underline-offset-2 hover:underline">privacy policy</a>. We only use your details to reply to your enquiry.</p>
    <p data-form-error role="alert" class="mt-4 hidden rounded-2xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700"></p>

    <button type="submit" class="btn-primary mt-6 w-full justify-center py-4 text-base disabled:opacity-60" data-magnetic>
      <span data-label>Send message</span>
      <svg data-arrow width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
    </button>
  </form>

  <!-- Success state, revealed after a successful submit -->
  <div data-form-success hidden class="absolute inset-0 grid place-items-center rounded-[2rem] bg-navy p-10 text-center text-white">
    <div>
      <svg class="mx-auto text-olive-300" width="84" height="84" viewBox="0 0 52 52" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle class="success-circle" cx="26" cy="26" r="23" />
        <path class="success-check" d="M15 27l7 7 15-16" />
      </svg>
      <h2 class="mt-6 text-3xl font-bold text-white" data-no-split>Message sent!</h2>
      <p class="mx-auto mt-3 max-w-sm text-white/75">Thanks for reaching out. We'll reply within one business day. For anything urgent, WhatsApp us.</p>
      <a href={site.whatsapp} class="btn mt-8 bg-olive text-white hover:bg-white hover:text-navy" rel="noopener" target="_blank">WhatsApp us</a>
    </div>
  </div>
</div>

<style>
  .field { display: grid; gap: 0.4rem; font-size: 0.875rem; font-weight: 600; color: var(--color-navy); }
  .field input, .field select, .field textarea {
    width: 100%; border-radius: 1rem; border: 1.5px solid rgb(19 33 58 / 0.12); background: var(--color-mist);
    padding: 0.85rem 1rem; font-size: 1rem; font-weight: 400; color: var(--color-ink);
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--color-olive); background: #fff; box-shadow: 0 0 0 4px rgb(85 107 47 / 0.15);
  }
  .field [aria-invalid='true'] { border-color: #dc2626; }
  .success-circle, .success-check { stroke-dasharray: 160; stroke-dashoffset: 160; }
  [data-form-success]:not([hidden]) .success-circle { animation: draw 0.8s ease-out forwards; }
  [data-form-success]:not([hidden]) .success-check { animation: draw 0.5s 0.6s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>

<script>
  import { gsap } from 'gsap';

  // Progressive enhancement: without JS the form posts normally and /api/contact/ redirects
  // to /thank-you/. With JS we submit in place and show the animated success state.
  const failed = new URLSearchParams(location.search).has('error');

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-form-error]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector<HTMLElement>('[data-label]')!;
    const success = form.parentElement!.querySelector<HTMLElement>('[data-form-success]')!;
    const showError = (msg: string) => { error.textContent = msg; error.classList.remove('hidden'); };
    if (failed) showError('Your message could not be sent. Please check the form and try again.');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.classList.add('hidden');

      let firstInvalid: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((el) => {
        const ok = el.checkValidity();
        el.setAttribute('aria-invalid', String(!ok));
        if (!ok && !firstInvalid) firstInvalid = el;
      });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        gsap.fromTo(form, { x: -8 }, { x: 0, duration: 0.5, ease: 'elastic.out(1, 0.3)' });
        return showError('Please fill in the required fields with valid details.');
      }

      const data = new FormData(form);
      data.set('page', location.pathname);
      button.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.ok) throw new Error(body.error || 'Something went wrong.');
        success.hidden = false;
        gsap.from(success, { opacity: 0, scale: 0.96, duration: 0.6, ease: 'power3.out' });
        form.reset();
      } catch (err) {
        showError(`${(err as Error).message} Please try again, or email us directly.`);
      } finally {
        button.disabled = false;
        label.textContent = 'Send message';
      }
    });
  });
</script>
