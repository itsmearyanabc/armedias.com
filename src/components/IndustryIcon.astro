---
// Small animated character for each industry card: a house that lights up, a beating heart,
// a tossed graduation cap, a bouncing bag, a typing terminal, a blinking robot, spinning
// chain links and a scanning shield. Faster while the card is hovered.
interface Props { slug: string; class?: string }
const { slug, class: className } = Astro.props;
---

<span class:list={['ind-icon', className]} aria-hidden="true">
  <svg viewBox="0 0 64 64">
    {slug === 'real-estate' && <>
      <path d="M10 30L32 12l22 18v24H10z" fill="#13213a" />
      <path d="M6 32L32 10l26 22" fill="none" stroke="#ff7a1a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      <rect class="win" x="18" y="34" width="10" height="9" rx="1.5" fill="#ffc93c" />
      <rect class="win w2" x="36" y="34" width="10" height="9" rx="1.5" fill="#ffc93c" />
      <rect x="27" y="44" width="10" height="10" rx="1.5" fill="#a9c46c" />
      <g class="sign"><path d="M50 40v14" stroke="#556b2f" stroke-width="2" /><rect x="44" y="34" width="16" height="8" rx="2" fill="#fff" stroke="#556b2f" /></g>
    </>}
    {slug === 'healthcare' && <>
      <path class="beat" d="M32 54S8 40 8 24a12 12 0 0 1 24-4 12 12 0 0 1 24 4c0 16-24 30-24 30z" fill="#ff7a1a" />
      <path class="ecg" d="M14 30h10l4-8 6 16 4-8h12" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </>}
    {slug === 'education' && <>
      <path d="M14 40c0 6 8 10 18 10s18-4 18-10v-8H14z" fill="#204a2b" />
      <g class="cap"><path d="M4 26l28-12 28 12-28 12z" fill="#13213a" /><path d="M54 29v12" stroke="#ffc93c" stroke-width="2.5" /><circle cx="54" cy="43" r="3" fill="#ffc93c" /></g>
    </>}
    {slug === 'retail-ecommerce' && <>
      <g class="bag"><path d="M14 22h36l-3 32H17z" fill="#ff7a1a" /><path d="M24 26v-6a8 8 0 0 1 16 0v6" fill="none" stroke="#13213a" stroke-width="3.5" stroke-linecap="round" /><path d="M24 36c2 4 14 4 16 0" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" /></g>
      <circle class="coin" cx="50" cy="14" r="6" fill="#ffc93c" stroke="#13213a" stroke-width="1.5" />
    </>}
    {slug === 'software-companies' && <>
      <rect x="6" y="12" width="52" height="40" rx="7" fill="#13213a" />
      <circle cx="13" cy="18" r="2" fill="#ff7a1a" /><circle cx="19" cy="18" r="2" fill="#ffc93c" /><circle cx="25" cy="18" r="2" fill="#a9c46c" />
      <path d="M14 30l6 5-6 5" fill="none" stroke="#a9c46c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <rect class="type" x="24" y="33" width="20" height="4" rx="2" fill="#fff" />
      <rect class="cursor" x="46" y="31" width="3" height="8" fill="#ff7a1a" />
    </>}
    {slug === 'ai-ml' && <>
      <path d="M32 6v8" stroke="#13213a" stroke-width="3" /><circle class="antenna" cx="32" cy="6" r="4" fill="#ff7a1a" />
      <rect x="10" y="14" width="44" height="36" rx="12" fill="#13213a" />
      <g class="eyes"><circle cx="24" cy="30" r="5" fill="#a9c46c" /><circle cx="40" cy="30" r="5" fill="#a9c46c" /></g>
      <path d="M24 41c4 3 12 3 16 0" stroke="#ffc93c" stroke-width="3" fill="none" stroke-linecap="round" />
      <rect x="4" y="26" width="6" height="12" rx="3" fill="#556b2f" /><rect x="54" y="26" width="6" height="12" rx="3" fill="#556b2f" />
    </>}
    {slug === 'blockchain-web3' && <>
      <g class="link"><rect x="6" y="22" width="30" height="20" rx="10" fill="none" stroke="#13213a" stroke-width="6" /></g>
      <g class="link l2"><rect x="28" y="22" width="30" height="20" rx="10" fill="none" stroke="#ff7a1a" stroke-width="6" /></g>
      <circle class="node" cx="32" cy="32" r="4" fill="#ffc93c" />
    </>}
    {slug === 'cybersecurity' && <>
      <path d="M32 4l22 8v16c0 14-9.5 24-22 30C19.5 52 10 42 10 28V12z" fill="#204a2b" />
      <rect x="23" y="28" width="18" height="15" rx="3" fill="#ffc93c" />
      <path class="shackle" d="M26 28v-5a6 6 0 0 1 12 0v5" fill="none" stroke="#ffc93c" stroke-width="3.5" />
      <rect class="scanline" x="12" y="10" width="40" height="3" rx="1.5" fill="#ff7a1a" />
    </>}
  </svg>
</span>

<style>
  .ind-icon { display: inline-grid; place-items: center; }
  .ind-icon svg { width: 100%; height: 100%; overflow: visible; }
  .ind-icon :is(.win, .sign, .beat, .cap, .bag, .coin, .type, .eyes, .antenna, .link, .node, .shackle, .scanline) { transform-box: fill-box; transform-origin: center; }

  .win { animation: ind-blink 2.4s steps(1) infinite; } .w2 { animation-delay: 1.2s; }
  .sign { transform-origin: 50% 100%; animation: ind-sway 2.6s ease-in-out infinite; }
  .beat { animation: ind-beat 1.1s ease-in-out infinite; }
  .ecg { stroke-dasharray: 60; animation: ind-ecg 1.6s linear infinite; }
  .cap { animation: ind-toss 2.8s cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
  .bag { transform-origin: 50% 100%; animation: ind-bounce 1.8s ease-in-out infinite; }
  .coin { animation: ind-coin 1.8s ease-in infinite; }
  .type { transform-origin: 0 50%; animation: ind-type 2.4s steps(5) infinite; }
  .cursor { animation: ind-blink 0.9s steps(1) infinite; }
  .eyes { animation: ind-look 3.4s ease-in-out infinite; }
  .antenna { animation: ind-blink 1.3s steps(1) infinite; }
  .link { animation: ind-wiggle 2.4s ease-in-out infinite; } .l2 { animation-direction: reverse; }
  .node { animation: ind-pulse 1.2s ease-in-out infinite; }
  .shackle { animation: ind-unlock 3s ease-in-out infinite; }
  .scanline { animation: ind-scan 2.2s ease-in-out infinite; }

  /* Faster and livelier while the card is hovered */
  :global(.group:hover) .ind-icon * { animation-duration: 0.8s; }

  @keyframes ind-blink { 50% { opacity: 0.25; } }
  @keyframes ind-sway { 50% { transform: rotate(8deg); } }
  @keyframes ind-beat { 0%, 100% { transform: scale(1); } 20% { transform: scale(1.12); } 40% { transform: scale(0.97); } 60% { transform: scale(1.06); } }
  @keyframes ind-ecg { from { stroke-dashoffset: 60; } to { stroke-dashoffset: -60; } }
  @keyframes ind-toss { 0%, 60%, 100% { transform: translateY(0) rotate(0); } 30% { transform: translateY(-10px) rotate(-12deg); } }
  @keyframes ind-bounce { 0%, 100% { transform: translateY(0) scaleY(1); } 45% { transform: translateY(-5px) scaleY(1.04); } 60% { transform: translateY(0) scaleY(0.94); } }
  @keyframes ind-coin { 0% { transform: translate(0, -6px); opacity: 0; } 30% { opacity: 1; } 70% { transform: translate(-14px, 14px); opacity: 1; } 100% { transform: translate(-16px, 20px); opacity: 0; } }
  @keyframes ind-type { 0% { transform: scaleX(0.1); } 100% { transform: scaleX(1); } }
  @keyframes ind-look { 0%, 100% { transform: translateX(0); } 30% { transform: translateX(-3px); } 60% { transform: translateX(3px); } }
  @keyframes ind-wiggle { 50% { transform: rotate(-8deg) translateX(-1px); } }
  @keyframes ind-pulse { 50% { transform: scale(1.5); opacity: 0.6; } }
  @keyframes ind-unlock { 0%, 50%, 100% { transform: translateY(0); } 65%, 85% { transform: translateY(-3px); } }
  @keyframes ind-scan { 0%, 100% { transform: translateY(0); opacity: 0.9; } 50% { transform: translateY(40px); opacity: 0.5; } }
  @media (prefers-reduced-motion: reduce) { .ind-icon * { animation: none !important; } }
</style>
