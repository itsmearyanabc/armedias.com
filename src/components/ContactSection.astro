---
// Lead form at the end of every page (Base renders it before the footer).
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
import BirdMascot from './BirdMascot.astro';
import Illustration from './illustrations/Illustration.astro';
---

<section id="contact" aria-labelledby="contact-section-heading" class="relative overflow-hidden bg-mist py-24 lg:py-32">
  <div aria-hidden="true" class="blob pointer-events-none absolute -left-32 top-10 size-[30rem] rounded-full bg-olive-300/30 blur-3xl"></div>
  <div class="container-x relative grid items-start gap-14 lg:grid-cols-[1fr_1.15fr]">
    <div class="lg:sticky lg:top-28">
      <div class="flex items-end justify-between gap-4">
        <p class="eyebrow">Start your project</p>
        <BirdMascot say="We reply fast!" flip class="hidden w-20 lg:inline-block" />
      </div>
      <h2 id="contact-section-heading" class="mt-4 text-4xl font-bold sm:text-5xl">Tell us what you want to build.</h2>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-slate">Share a few details and we'll reply within one business day with next steps and a free consultation.</p>
      <ul class="mt-8 space-y-3 text-navy [&_a]:inline-flex [&_a]:items-center [&_a]:gap-2.5">
        <li><a href={`tel:${site.phoneE164}`} class="font-semibold hover:text-olive"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>{site.phone}</a></li>
        <li><a href={site.whatsapp} class="font-semibold hover:text-olive" rel="noopener" target="_blank"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" /></svg>WhatsApp us</a></li>
        <li><a href={`mailto:${site.email}`} class="font-semibold hover:text-olive"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-olive"><path d="M4 4h16v16H4zM4 6l8 7 8-7" /></svg>{site.email}</a></li>
      </ul>
      <ul class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-navy/10 pt-8 text-sm text-slate">
        <li><span class="block font-display text-2xl font-bold text-navy">{site.projectsDelivered}+</span>Projects</li>
        <li><span class="block font-display text-2xl font-bold text-navy">24h</span>Reply time</li>
        <li><span class="block font-display text-2xl font-bold text-navy">Free</span>Consultation</li>
      </ul>
      <div class="mt-8 hidden max-w-sm lg:block"><Illustration name="message" title="Chat bubbles and a paper plane" /></div>
    </div>
    <div data-reveal="up"><ContactForm title="Get a free quote" /></div>
  </div>
</section>
