---
// Rolling belt of client logos (or name wordmarks). Renders nothing until clients.ts has
// entries, so no placeholder brands ever appear.
import { Image } from 'astro:assets';
import { clients } from '../data/clients';

const rows = clients.length >= 10
  ? [clients.filter((_, i) => i % 2 === 0), clients.filter((_, i) => i % 2 === 1)]
  : [clients];
// Repeat short lists so the belt is always wider than the screen
const fill = (row: typeof clients) => Array.from({ length: Math.max(2, Math.ceil(10 / Math.max(row.length, 1))) }, () => row).flat();
---

{clients.length > 0 && (
  <section aria-labelledby="clients-heading" class="border-y border-navy/8 bg-white py-12">
    <h2 id="clients-heading" class="container-x mb-8 text-center text-sm font-semibold uppercase tracking-[0.2em] text-slate" data-no-split>
      Trusted by growing businesses
    </h2>
    {rows.map((row, i) => (
      <div class="marquee mb-6 last:mb-0" data-reverse={i === 1 ? '' : undefined} style="--speed: 45s; --gap: 3rem">
        {[0, 1].map((copy) => (
          <ul class="marquee__track items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
            {fill(row).map((c, n) => (
              <li class="client grid h-16 place-items-center" aria-hidden={n >= row.length ? 'true' : undefined}>
                {c.logo
                  ? <Image src={c.logo} alt={c.name} height={48} class="h-10 w-auto max-w-[10rem] object-contain" />
                  : <span class="whitespace-nowrap font-display text-2xl font-bold tracking-tight text-navy">{c.name}</span>}
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))}
  </section>
)}

<style>
  /* <Image> output isn't scoped to this component, so children are matched globally */
  .client > :global(*) { filter: grayscale(1); opacity: 0.55; transition: filter 0.3s, opacity 0.3s, transform 0.3s; }
  .client:hover > :global(*) { filter: none; opacity: 1; transform: scale(1.08); }
  .client span { color: var(--color-navy); }
  .client:hover span { color: var(--color-olive); }
</style>
