---
// Footer social icons with official logos. Links are set in /admin/ and loaded from
// /api/social/; icons stay hidden until their link exists.
import { siFacebook, siInstagram, siX } from 'simple-icons';

// LinkedIn is not in Simple Icons (removed at LinkedIn's request), so its "in" mark is drawn here
const linkedin = {
  hex: '0A66C2',
  path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
};

const networks = [
  { key: 'linkedin', label: 'LinkedIn', ...linkedin },
  { key: 'instagram', label: 'Instagram', hex: siInstagram.hex, path: siInstagram.path },
  { key: 'facebook', label: 'Facebook', hex: siFacebook.hex, path: siFacebook.path },
  { key: 'x', label: 'X', hex: siX.hex, path: siX.path },
];
---

<ul class="social flex items-center gap-2.5" data-socials hidden aria-label="AR Medias on social media">
  {networks.map((n) => (
    <li data-social={n.key} hidden>
      <a href="#" target="_blank" rel="noopener me" aria-label={`AR Medias on ${n.label}`} class="social-link grid size-10 place-items-center rounded-full bg-white shadow-lg shadow-black/20" style={`--brand:#${n.hex}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill={`#${n.hex}`}><path d={n.path} /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social-link { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s, box-shadow 0.3s; }
  .social-link svg { transition: transform 0.3s, fill 0.3s; }
  .social-link:hover { transform: translateY(-4px) rotate(-6deg); background: var(--brand); box-shadow: 0 12px 24px -10px var(--brand); }
  .social-link:hover svg { fill: #fff; transform: scale(1.1); }
  .social li { animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  .social li:nth-child(2) { animation-delay: 0.08s; } .social li:nth-child(3) { animation-delay: 0.16s; } .social li:nth-child(4) { animation-delay: 0.24s; }
  @keyframes pop-in { from { transform: scale(0.4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .social li { animation: none; } }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-socials]');
  if (list) {
    fetch('/api/social/')
      .then((r) => (r.ok ? r.json() : {}))
      .then((links: Record<string, string>) => {
        let shown = 0;
        list.querySelectorAll<HTMLElement>('[data-social]').forEach((li) => {
          const url = links[li.dataset.social!];
          if (!url) return;
          li.querySelector('a')!.href = url;
          li.hidden = false;
          shown++;
        });
        list.hidden = shown === 0;
      })
      .catch(() => { /* no links: icons stay hidden */ });
  }
</script>
