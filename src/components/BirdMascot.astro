---
// "Ari", the bird from the AR Medias logo, as a small mascot. It bobs, blinks, tilts its
// head, follows the cursor with its eye, flaps when hovered and can say a short line.
// Pages can drive extra states by toggling classes: is-flying, is-waving, is-happy.
interface Props { say?: string; class?: string; flip?: boolean; style?: string; interactive?: boolean; id?: string }
const { say, class: className, flip = false, style, interactive = false, id } = Astro.props;
const Tag = interactive ? 'button' : 'div';
---

<Tag
  class:list={['mascot group/bird', className, flip && 'mascot--flip', interactive && 'mascot--interactive']}
  data-mascot
  {id}
  {style}
  type={interactive ? 'button' : undefined}
  aria-label={interactive ? 'Ari the bird. Tap to say hi' : undefined}
>
  {(say || interactive) && <span class="mascot-say" data-say aria-live="polite">{say}</span>}
  <svg viewBox="0 0 120 100" aria-hidden="true" class="mascot-svg">
    <g class="m-body">
      <path d="M18 70c-8 2-14 0-16-3 8 0 14-3 18-7z" fill="#556b2f" />
      <path d="M22 62c4-18 20-30 40-30 14 0 24 8 26 20 2 14-10 26-30 28-16 2-30-4-36-18z" fill="#13213a" />
      <g class="m-head">
        <circle cx="82" cy="34" r="17" fill="#13213a" />
        <path d="M97 31l14 5-14 4z" fill="#ff7a1a" />
        <g class="m-eye">
          <circle cx="86" cy="30" r="5.5" fill="#fff" />
          <circle class="m-pupil" cx="87" cy="30" r="2.6" fill="#13213a" />
          <rect class="m-lid" x="80" y="24" width="12" height="12" rx="6" fill="#13213a" />
        </g>
        <circle cx="80" cy="39" r="3" fill="#ff7a1a" opacity="0.35" />
      </g>
      <path class="m-wing" d="M40 52c10-6 26-6 34 2-8 10-24 14-36 8z" fill="#a9c46c" />
      <g class="m-legs">
        <path d="M50 79l-2 9M62 79l2 9" stroke="#ff7a1a" stroke-width="3" stroke-linecap="round" />
        <path d="M44 89h10M58 89h10" stroke="#ff7a1a" stroke-width="3" stroke-linecap="round" />
      </g>
    </g>
  </svg>
</Tag>

<style>
  /* Base box in Tailwind's components layer, so utility classes passed in (w-20, hidden,
     absolute…) override it */
  @layer components {
    .mascot { position: relative; display: inline-block; width: 7rem; }
  }
  .mascot--flip .mascot-svg { transform: scaleX(-1); }
  .mascot-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .mascot :is(.m-body, .m-head, .m-wing, .m-lid) { transform-box: fill-box; }
  .m-body { transform-origin: 50% 100%; animation: m-bob 2.8s ease-in-out infinite; }
  .m-head { transform-origin: 30% 80%; animation: m-tilt 5s ease-in-out infinite; }
  .m-wing { transform-origin: 10% 50%; animation: m-wing 3.2s ease-in-out infinite; }
  .m-lid { transform-origin: 50% 0%; transform: scaleY(0); animation: m-blink 4.5s infinite; }
  .m-pupil { transition: transform 0.2s ease-out; }
  .group\/bird:hover .m-wing { animation: m-flap 0.25s ease-in-out infinite alternate; }
  .group\/bird:hover .m-body { animation: m-hop 0.6s ease-in-out infinite; }

  /* Interactive bird: a real button, so it can be tapped and focused */
  .mascot--interactive { cursor: pointer; border: 0; background: none; padding: 0; -webkit-tap-highlight-color: transparent; }
  .mascot--interactive:focus-visible { outline: 3px solid var(--color-ember); outline-offset: 6px; border-radius: 999px; }
  .mascot-say:empty { display: none; }
  /* Flying: fast flaps, legs tucked, no idle bob */
  .mascot.is-flying .m-wing { animation: m-flap 0.11s ease-in-out infinite alternate; }
  .mascot.is-flying .m-body { animation: none; }
  .mascot.is-flying .m-legs { opacity: 0; }
  .m-legs { transition: opacity 0.2s; }
  /* Waving hello with the wing */
  .mascot.is-waving .m-wing { animation: m-wave 0.35s ease-in-out 4 alternate; }
  /* Happy hop after a tap */
  .mascot.is-happy .m-body { animation: m-happy 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes m-wave { from { transform: rotate(10deg); } to { transform: rotate(-55deg); } }
  @keyframes m-happy { 0% { transform: translateY(0) scale(1); } 30% { transform: translateY(2px) scale(1.08, 0.9); } 60% { transform: translateY(-14px) rotate(-6deg); } 100% { transform: none; } }

  .mascot-say {
    position: absolute; bottom: 100%; left: 50%; translate: -50% -0.25rem; white-space: nowrap;
    border-radius: 999px; background: #fff; color: var(--color-navy); padding: 0.4rem 0.8rem;
    font-family: var(--font-display); font-size: 0.8rem; font-weight: 700;
    box-shadow: 0 10px 25px -10px rgb(19 33 58 / 0.4); animation: m-say 4s ease-in-out infinite;
  }
  .mascot-say::after { content: ''; position: absolute; left: 50%; top: 100%; translate: -50% -1px; border: 6px solid transparent; border-top-color: #fff; }

  @keyframes m-bob { 50% { transform: translateY(-3px); } }
  @keyframes m-hop { 50% { transform: translateY(-8px) rotate(-3deg); } }
  @keyframes m-tilt { 0%, 40%, 100% { transform: rotate(0); } 50%, 70% { transform: rotate(-12deg); } }
  @keyframes m-wing { 0%, 80%, 100% { transform: rotate(0); } 85% { transform: rotate(-18deg); } 90% { transform: rotate(4deg); } }
  @keyframes m-flap { from { transform: rotate(-25deg); } to { transform: rotate(10deg); } }
  @keyframes m-blink { 0%, 92%, 100% { transform: scaleY(0); } 95% { transform: scaleY(1); } }
  @keyframes m-say { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { .mascot * { animation: none !important; } }
</style>

<script>
  // The eye follows the pointer (desktop only)
  if (matchMedia('(hover: hover)').matches) {
    const pupils = [...document.querySelectorAll<SVGCircleElement>('[data-mascot] .m-pupil')];
    if (pupils.length) addEventListener('pointermove', (e) => {
      for (const p of pupils) {
        const r = p.getBoundingClientRect();
        const flip = p.closest('.mascot--flip') ? -1 : 1;
        const a = Math.atan2(e.clientY - (r.top + r.height / 2), (e.clientX - (r.left + r.width / 2)) * flip);
        p.style.transform = `translate(${Math.cos(a) * 1.6}px, ${Math.sin(a) * 1.6}px)`;
      }
    }, { passive: true });
  }
</script>
