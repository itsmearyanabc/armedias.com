---
// "AY" monogram used for the founder on About, the founder page and blog bylines.
interface Props { size: number; class?: string }
const { size, class: className } = Astro.props;
---

<span aria-hidden="true" class:list={['grid place-items-center rounded-full bg-navy font-display font-bold text-olive-300', className]} style={`font-size:${Math.round(size * 0.32)}px`}>AY</span>
