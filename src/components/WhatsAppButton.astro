---
// Floating WhatsApp chat button: white circle with the WhatsApp-green glyph. The link goes through /api/whatsapp/, which redirects to
// the number set in /admin/.
import { site } from '../data/site';
---

<a href={site.whatsapp} target="_blank" rel="noopener nofollow" class="wa-btn" aria-label="Chat with us on WhatsApp" data-wa>
  <span class="wa-ring" aria-hidden="true"></span>
  <span class="wa-ring wa-ring--2" aria-hidden="true"></span>
  <span class="wa-tip" aria-hidden="true">Chat with us</span>
  <span class="wa-face">
    <svg class="wa-icon" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="#25d366">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z" />
    </svg>
    <svg class="wa-check" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="#25d366" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
  </span>
</a>

<style>
  .wa-btn {
    position: fixed; right: max(1.25rem, env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 55; display: grid; place-items: center; width: 3.75rem; height: 3.75rem; border-radius: 999px;
    background: #fff; box-shadow: 0 12px 30px -8px rgb(19 33 58 / 0.35), 0 4px 10px -4px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(19 33 58 / 0.06);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s;
    animation: wa-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s both;
    -webkit-tap-highlight-color: transparent;
  }
  .wa-btn:hover { transform: scale(1.08) rotate(-6deg); box-shadow: 0 16px 36px -8px rgb(37 211 102 / 0.55), 0 4px 10px -4px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(37 211 102 / 0.25); }
  .wa-btn:active { transform: scale(0.9); }
  .wa-btn:focus-visible { outline: 3px solid var(--color-ember); outline-offset: 4px; }

  .wa-face { position: relative; display: grid; place-items: center; overflow: hidden; width: 100%; height: 100%; border-radius: inherit; }
  .wa-icon, .wa-check { grid-area: 1 / 1; transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s; }
  .wa-check { transform: translateY(140%) scale(0.5); opacity: 0; }

  /* Breathing rings that invite a tap */
  .wa-ring { position: absolute; inset: 0; border-radius: inherit; border: 2px solid rgb(255 255 255 / 0.9); box-shadow: 0 0 0 1px rgb(37 211 102 / 0.35); pointer-events: none;
    animation: wa-pulse 2.8s ease-out 2.2s infinite; opacity: 0; }
  .wa-ring--2 { animation-delay: 3.2s; }

  .wa-tip { position: absolute; right: calc(100% + 0.75rem); top: 50%; translate: 0 -50%; white-space: nowrap;
    border-radius: 999px; background: var(--color-navy); color: #fff; font-size: 0.85rem; font-weight: 600;
    padding: 0.5rem 0.9rem; box-shadow: 0 10px 25px -10px rgb(19 33 58 / 0.5);
    opacity: 0; transform: translateX(8px); transition: opacity 0.25s, transform 0.25s; pointer-events: none; }
  .wa-btn:hover .wa-tip, .wa-btn:focus-visible .wa-tip { opacity: 1; transform: none; }

  /* Click micro-interaction: squish, burst ring, icon swaps to a check */
  .wa-btn.is-clicked { animation: wa-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .wa-btn.is-clicked .wa-icon { transform: translateY(-140%) scale(0.5) rotate(-20deg); opacity: 0; }
  .wa-btn.is-clicked .wa-check { transform: none; opacity: 1; }
  /* Created by the script, so it isn't scoped: target it via :global */
  .wa-btn :global(.wa-burst) { position: absolute; inset: 0; border-radius: 999px; pointer-events: none; background: #25d366;
    animation: wa-burst 0.7s ease-out forwards; }

  @keyframes wa-in { from { transform: scale(0) rotate(-120deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes wa-pulse { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.9); opacity: 0; } }
  @keyframes wa-pop { 0% { transform: scale(1); } 30% { transform: scale(0.82); } 65% { transform: scale(1.15); } 100% { transform: scale(1); } }
  @keyframes wa-burst { from { transform: scale(1); opacity: 0.55; } to { transform: scale(2.6); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .wa-btn, .wa-ring { animation: none; }
    .wa-ring { display: none; }
  }
  @media print { .wa-btn { display: none; } }
</style>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-wa]');
  btn?.addEventListener('click', () => {
    // The link opens in a new tab straight away; this only plays the feedback animation
    btn.classList.remove('is-clicked');
    void btn.offsetWidth;
    btn.classList.add('is-clicked');
    const burst = Object.assign(document.createElement('span'), { className: 'wa-burst' });
    btn.prepend(burst);
    burst.addEventListener('animationend', () => burst.remove());
    navigator.vibrate?.(15);
    setTimeout(() => btn.classList.remove('is-clicked'), 1600);
  });
</script>
