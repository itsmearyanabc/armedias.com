---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, markets, maps } from '../data/site';
import { ogPathFor } from '../lib/og';
// The two font files every page needs first; preloading them avoids a visible font swap
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Pages that are the contact flow themselves skip the end-of-page form */
  hideContact?: boolean;
  /** Page language; Russian city pages pass 'ru' */
  lang?: 'en' | 'ru';
}

const { title, description, ogImage = ogPathFor(Astro.url.pathname) ?? '/og-default.png', noindex = false, schema = [], hideContact = false, lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: site.alternateNames,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/icon-512.png`,
  email: site.email,
  telephone: site.phoneE164,
  foundingDate: site.founded,
  taxID: site.gstin,
  founder: { '@type': 'Person', '@id': `${site.url}/about/aryan-yadav/#person`, name: site.founder.name, sameAs: site.founder.linkedin },
  slogan: site.tagline,
  description: site.tagline,
  knowsAbout: ['Website development', 'Mobile app development', 'E-commerce development', 'UI/UX design', 'CRM development', 'ERP development', 'Custom software development', 'AI automation', 'WhatsApp automation'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: site.phoneE164,
    email: site.email,
    areaServed: markets.map((m) => m.code),
    availableLanguage: ['English', 'Hindi'],
  },
  hasMap: maps.listing,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: markets.map((m) => ({ '@type': 'Country', name: m.schemaName })),
  sameAs: site.sameAs,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  alternateName: site.alternateNames,
  url: site.url,
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#organization` },
};
const jsonLd = [organization, website, ...schema];
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="AR Medias Blog" href="/rss.xml" />
    <meta name="theme-color" content="#13213a" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_IN'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Automated browsers (crawlers, renderers) get the same content without the hidden
      // start state. If the motion script never starts, content is shown after 4 s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !navigator.webdriver) {
        const root = document.documentElement;
        root.classList.add('js-motion');
        setTimeout(() => { if (!root.dataset.motion) root.classList.remove('js-motion'); }, 4000);
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-navy focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
      {!hideContact && <ContactSection />}
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import { initMotion } from '../scripts/motion';
      import { pauseOffscreenLoops } from '../scripts/offscreen';
      initMotion();
      pauseOffscreenLoops();

      // Cookieless pageview beacon for the admin dashboard (see src/server/analytics.ts)
      if (import.meta.env.PROD) {
        navigator.sendBeacon('/api/track/', JSON.stringify({ p: location.pathname, r: document.referrer }));
      }
    </script>
  </body>
</html>
