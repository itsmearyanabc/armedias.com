---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, markets } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Pages that are the contact flow themselves skip the end-of-page form */
  hideContact?: boolean;
}

const { title, description, ogImage = '/og-default.png', noindex = false, schema = [], hideContact = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/icon-512.png`,
  email: site.email,
  telephone: site.phoneE164,
  foundingDate: site.founded,
  founder: { '@type': 'Person', name: site.founder.name, sameAs: site.founder.linkedin },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: markets.map((m) => ({ '@type': 'Country', name: m.schemaName })),
  sameAs: site.sameAs,
};
const jsonLd = [organization, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#13213a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-navy focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
      {!hideContact && <ContactSection />}
    </main>
    <Footer />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();

      // Cookieless pageview beacon for the admin dashboard (see src/server/analytics.ts)
      if (import.meta.env.PROD) {
        navigator.sendBeacon('/api/track/', JSON.stringify({ p: location.pathname, r: document.referrer }));
      }
    </script>
  </body>
</html>
