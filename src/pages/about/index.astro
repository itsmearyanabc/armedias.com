---
import Base from '../../layouts/Base.astro';
import FounderAvatar from '../../components/FounderAvatar.astro';
import { site, markets, pillars } from '../../data/site';

const title = 'About AR Medias | IT Company in New Delhi Since 2024';
const description = `AR Medias is a founder-led IT company in New Delhi, founded on 1 January 2024 by ${site.founder.name}. ${site.projectsDelivered}+ projects delivered across web, apps, CRM/ERP and AI automation for clients in seven countries.`;

const values = [
  { t: 'Outcomes over output', d: 'We measure success by leads, sales and hours saved, not by the number of screens shipped.' },
  { t: 'Straight answers', d: 'Fixed quotes, honest timelines and a clear "no" when something is not worth building.' },
  { t: 'Craft in the details', d: 'Fast pages, clean code, smooth motion and interfaces that feel obvious to use.' },
  { t: 'Long-term partners', d: 'Most of our work continues after launch, improving and growing with each client.' },
];

const timeline = [
  { y: '2024', t: 'AR Medias is founded', d: `${site.founder.name} starts AR Medias in New Delhi on 1 January 2024 to build websites and software for growing businesses.` },
  { y: 'Growth', t: 'From websites to systems', d: 'Client needs grow from websites into mobile apps, custom CRMs, ERPs and AI-powered automation.' },
  { y: 'Today', t: `${site.projectsDelivered}+ projects, ${markets.length} countries`, d: `Serving clients in ${markets.map((m) => m.country).join(', ')} from our office in Kirti Nagar, New Delhi.` },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: `${site.url}/about/`,
    mainEntity: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about/` },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <!-- HERO -->
  <section class="relative overflow-hidden pb-20 pt-32 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="blob absolute -right-24 -top-24 size-[36rem] rounded-full bg-olive-300/35 blur-3xl"></div>
      <div class="blob absolute -left-20 bottom-0 size-[26rem] rounded-full bg-navy/10 blur-3xl"></div>
    </div>
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-slate" data-hero><a href="/" class="hover:text-olive">Home</a> / <span>About</span></nav>
      <p class="eyebrow mt-6" data-hero>About AR Medias</p>
      <h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[1.03] sm:text-6xl xl:text-7xl" data-hero>
        We build the technology that helps businesses <span class="text-olive">grow faster.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate" data-hero>
        AR Medias is a founder-led IT company based in New Delhi. Since 2024 we have designed and built websites, mobile apps, CRM and ERP systems and AI automation for businesses across {markets.length} countries.
      </p>
      <dl class="mt-12 grid max-w-3xl grid-cols-2 gap-8 border-t border-navy/10 pt-8 sm:grid-cols-4" data-hero>
        <div class="flex flex-col"><dt class="text-sm text-slate">Projects delivered</dt><dd class="order-first font-display text-4xl font-bold text-navy"><span data-count={site.projectsDelivered}>{site.projectsDelivered}</span>+</dd></div>
        <div class="flex flex-col"><dt class="text-sm text-slate">Countries served</dt><dd class="order-first font-display text-4xl font-bold text-navy"><span data-count={markets.length}>{markets.length}</span></dd></div>
        <div class="flex flex-col"><dt class="text-sm text-slate">Service areas</dt><dd class="order-first font-display text-4xl font-bold text-navy"><span data-count={pillars.length}>{pillars.length}</span></dd></div>
        <div class="flex flex-col"><dt class="text-sm text-slate">Founded</dt><dd class="order-first font-display text-4xl font-bold text-navy">2024</dd></div>
      </dl>
    </div>
  </section>

  <!-- MISSION: scroll-scrubbed text highlight -->
  <section class="bg-navy py-24 text-white lg:py-32">
    <div class="container-x">
      <p class="eyebrow text-olive-300!">Our mission</p>
      <p class="scrub-text mt-6 max-w-5xl font-display text-3xl font-semibold leading-snug sm:text-4xl lg:text-5xl">
        Every growing business deserves software as good as the big players use: fast, reliable, built around how they work, and from a team that picks up the phone.
      </p>
    </div>
  </section>

  <!-- STORY TIMELINE -->
  <section class="py-24 lg:py-32">
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_1.4fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow" data-reveal="fade">Our story</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Started in New Delhi. Trusted across seven countries.</h2>
      </div>
      <ol class="timeline relative space-y-12 pl-10">
        <span aria-hidden="true" class="timeline-line absolute left-[0.6rem] top-2 h-[calc(100%-1rem)] w-0.5 origin-top bg-olive"></span>
        {timeline.map((e) => (
          <li class="timeline-item relative">
            <span aria-hidden="true" class="absolute -left-10 top-1 size-5 rounded-full border-4 border-white bg-olive ring-2 ring-olive"></span>
            <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-olive">{e.y}</p>
            <h3 class="mt-2 text-2xl font-bold">{e.t}</h3>
            <p class="mt-2 text-lg leading-relaxed text-slate">{e.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="bg-mist/60 py-24 lg:py-28">
    <div class="container-x">
      <a href="/about/aryan-yadav/" data-tilt class="group grid items-center gap-10 overflow-hidden rounded-[2.5rem] bg-white p-8 ring-1 ring-navy/5 sm:p-12 lg:grid-cols-[auto_1fr]">
        <div class="founder-avatar relative mx-auto size-48 sm:size-56">
          <FounderAvatar size={224} class="size-full" />
          <span aria-hidden="true" class="founder-ring absolute -inset-3 rounded-full border-2 border-dashed border-olive/40"></span>
        </div>
        <div>
          <p class="eyebrow">Meet the founder</p>
          <h2 class="mt-3 text-4xl font-bold sm:text-5xl" data-no-split>{site.founder.name}</h2>
          <p class="mt-2 text-lg font-medium text-olive">Founder, AR Medias</p>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate">
            {site.founder.name} founded AR Medias in January 2024 and leads every client engagement, from the first call to launch and beyond.
          </p>
          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-olive">Read Aryan's story <span class="transition-transform group-hover:translate-x-1">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <!-- VALUES -->
  <section class="py-24 lg:py-28">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade">How we work</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">What every client can count on.</h2>
      </div>
      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
        {values.map((v, i) => (
          <li data-tilt class="rounded-3xl bg-navy p-8 text-white">
            <span class="font-display text-5xl font-bold text-olive-300/40">0{i + 1}</span>
            <h3 class="mt-4 text-xl font-bold text-white">{v.t}</h3>
            <p class="mt-2 leading-relaxed text-white/70">{v.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x pb-24">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-olive px-8 py-16 text-center text-white sm:px-16 lg:py-20" data-reveal="up">
      <div aria-hidden="true" class="blob pointer-events-none absolute -right-20 -top-20 size-80 rounded-full bg-olive-300/40 blur-3xl"></div>
      <h2 class="relative mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl">Let's build something together.</h2>
      <p class="relative mx-auto mt-5 max-w-xl text-lg text-white/85">Visit us in Kirti Nagar, New Delhi, or book a call from anywhere in the world.</p>
      <div class="relative mt-9 flex flex-wrap justify-center gap-3">
        <a href="/contact/" class="btn bg-white text-navy hover:bg-navy hover:text-white" data-magnetic>Contact us</a>
        <a href="/services/" class="btn border-2 border-white/40 text-white hover:border-white">Our services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .founder-ring { animation: spin 24s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .js-motion .scrub-text :global(.sw) { opacity: 0.18; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (document.documentElement.classList.contains('js-motion')) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.from('[data-hero]', { y: 30, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.1 });

    // Mission text lights up word by word as it scrolls through the viewport
    const scrub = document.querySelector<HTMLElement>('.scrub-text');
    if (scrub) {
      const words = scrub.textContent!.trim().split(/\s+/);
      scrub.innerHTML = words.map((w) => `<span class="sw">${w}</span>`).join(' ');
      gsap.to(scrub.querySelectorAll('.sw'), {
        opacity: 1, stagger: 0.1, ease: 'none',
        scrollTrigger: { trigger: scrub, start: 'top 80%', end: 'bottom 45%', scrub: true },
      });
    }

    gsap.fromTo('.timeline-line', { scaleY: 0 }, {
      scaleY: 1, ease: 'none',
      scrollTrigger: { trigger: '.timeline', start: 'top 70%', end: 'bottom 60%', scrub: true },
    });
    gsap.utils.toArray<HTMLElement>('.timeline-item').forEach((el) => {
      gsap.from(el, { opacity: 0, y: 40, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 82%', once: true } });
    });
  }
</script>
