---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { process as steps } from '../data/process';
import Scribble from '../components/Scribble.astro';

const title = 'Our Process | How AR Medias Delivers Software Projects';
const description =
  'How AR Medias delivers websites, apps, CRM/ERP and AI automation: discovery, design, build, launch and support. Fixed quotes, weekly demos and full ownership of your code.';

const models = [
  { t: 'Fixed-price project', d: 'A clear scope, fixed quote and milestone payments. Best for websites, apps and well-defined builds.', tag: 'Most popular' },
  { t: 'Dedicated team', d: 'Developers and designers working as an extension of your team, billed monthly. Best for ongoing products.', tag: 'Scale up' },
  { t: 'Monthly retainer', d: 'A set number of hours each month for improvements, support, SEO and new features.', tag: 'After launch' },
];

const promises = [
  { t: 'Weekly demos', d: 'See working software every week on a private staging link.' },
  { t: 'One point of contact', d: 'A dedicated project lead who answers your messages the same day.' },
  { t: 'Your time zone', d: 'Calls scheduled in your working hours, wherever you are.' },
  { t: 'Shared visibility', d: 'A live task board so you always know what is done and what is next.' },
  { t: 'NDA on request', d: 'We sign a non-disclosure agreement before you share details.' },
  { t: 'You own everything', d: 'Code, designs, domains and accounts are transferred to you.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Process', item: `${site.url}/process/` },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <!-- HERO -->
  <section class="relative overflow-hidden pb-20 pt-32 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="blob absolute -right-24 -top-24 size-[36rem] rounded-full bg-olive-300/35 blur-3xl"></div>
      <div class="blob absolute -left-24 bottom-0 size-[26rem] rounded-full bg-navy/10 blur-3xl"></div>
    </div>
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-slate" data-hero><a href="/" class="hover:text-olive">Home</a> / <span>Process</span></nav>
      <p class="eyebrow mt-6" data-hero>Our process</p>
      <h1 class="mt-4 max-w-5xl text-5xl font-bold leading-[1.03] sm:text-6xl xl:text-7xl" data-hero>
        No surprises. Just a clear path from <Scribble><span class="text-olive">idea to launch.</span></Scribble>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate" data-hero>
        The same five steps behind {site.projectsDelivered}+ projects. You always know what is happening, what it costs, and what comes next.
      </p>
      <ol class="mt-12 flex flex-wrap items-center gap-2" data-hero aria-label="Process overview">
        {steps.map((s, i) => (
          <li class="flex items-center gap-2">
            <a href={`#step-${i + 1}`} class="rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-olive">0{i + 1} {s.t}</a>
            {i < steps.length - 1 && <span aria-hidden="true" class="hidden h-px w-6 bg-navy/20 sm:block"></span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- STEPS: pinned horizontal scroll on desktop, stacked on mobile -->
  <section class="hscroll relative overflow-hidden bg-navy text-white" aria-label="Process steps">
    <div class="hscroll-progress absolute left-0 top-0 h-1 w-full origin-left scale-x-0 bg-gradient-to-r from-ember to-sun" aria-hidden="true"></div>
    <div class="hscroll-track flex flex-col gap-6 px-4 py-20 sm:px-6 lg:h-screen lg:flex-row lg:items-center lg:gap-8 lg:px-[8vw] lg:py-0">
      {steps.map((s, i) => (
        <article id={`step-${i + 1}`} class="step-panel relative flex shrink-0 flex-col overflow-hidden rounded-[2rem] bg-white/6 p-8 ring-1 ring-white/10 sm:p-10 lg:h-[72vh] lg:w-[min(46rem,78vw)]">
          <span aria-hidden="true" class="step-num pointer-events-none absolute -right-4 -top-10 font-display text-[11rem] font-bold leading-none text-white/[0.05] sm:text-[15rem]">0{i + 1}</span>
          <div class="flex items-center gap-3">
            <span class="grid size-12 place-items-center rounded-full bg-ember font-display font-bold text-navy">0{i + 1}</span>
            <span class="rounded-full bg-white/10 px-3 py-1 text-sm text-white/80">{s.duration}</span>
          </div>
          <h2 class="mt-6 text-4xl font-bold text-white sm:text-5xl" data-no-split>{s.t}</h2>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/75">{s.d}</p>
          <div class="mt-auto grid gap-8 pt-10 sm:grid-cols-2">
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-300">What happens</h3>
              <ul class="mt-4 space-y-2.5">
                {s.activities.map((a) => <li class="flex gap-2.5 text-white/85"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-ember"></span>{a}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-300">You receive</h3>
              <ul class="mt-4 space-y-2.5">
                {s.outputs.map((o) => (
                  <li class="flex gap-2.5 text-white/85">
                    <svg class="mt-0.5 shrink-0 text-olive-300" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9" /></svg>
                    {o}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- PROMISES -->
  <section class="py-24 lg:py-32">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade">Working with us</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">What you can expect on every project.</h2>
      </div>
      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
        {promises.map((p) => (
          <li data-tilt class="rounded-3xl bg-mist p-8">
            <span class="grid size-11 place-items-center rounded-2xl bg-olive text-white">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9" /></svg>
            </span>
            <h3 class="mt-5 text-xl font-bold">{p.t}</h3>
            <p class="mt-2 leading-relaxed text-slate">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ENGAGEMENT MODELS -->
  <section class="bg-mist/60 py-24 lg:py-28">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade">Ways to work together</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Pick the model that fits your project.</h2>
      </div>
      <ul class="mt-14 grid gap-5 lg:grid-cols-3" data-reveal="stagger">
        {models.map((m, i) => (
          <li data-tilt class={`flex flex-col rounded-[2rem] p-9 ${i === 0 ? 'bg-navy text-white shadow-2xl shadow-navy/25' : 'bg-white ring-1 ring-navy/8'}`}>
            <span class={`self-start rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider ${i === 0 ? 'bg-ember text-navy' : 'bg-olive/10 text-olive'}`}>{m.tag}</span>
            <h3 class={`mt-6 text-2xl font-bold ${i === 0 ? 'text-white' : ''}`}>{m.t}</h3>
            <p class={`mt-3 flex-1 leading-relaxed ${i === 0 ? 'text-white/75' : 'text-slate'}`}>{m.d}</p>
            <a href="/contact/" class={`mt-8 font-semibold ${i === 0 ? 'text-olive-300 hover:text-white' : 'text-olive hover:text-navy'}`}>Discuss this option →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x py-24">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-olive px-8 py-16 text-center text-white sm:px-16 lg:py-20" data-reveal="up">
      <div aria-hidden="true" class="blob pointer-events-none absolute -right-20 -top-20 size-80 rounded-full bg-olive-300/40 blur-3xl"></div>
      <h2 class="relative mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl">Step one is a free call.</h2>
      <p class="relative mx-auto mt-5 max-w-xl text-lg text-white/85">30 minutes, no obligation. You leave with a clear plan, timeline and price.</p>
      <div class="relative mt-9 flex flex-wrap justify-center gap-3">
        <a href="/contact/" class="btn-ember" data-magnetic>Book a free call</a>
        <a href={site.whatsapp} class="btn border-2 border-white/40 text-white hover:border-white" rel="noopener" target="_blank">WhatsApp us</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (document.documentElement.classList.contains('js-motion')) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.from('[data-hero]', { y: 30, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.1 });

    const section = document.querySelector<HTMLElement>('.hscroll')!;
    const track = section.querySelector<HTMLElement>('.hscroll-track')!;
    const panels = gsap.utils.toArray<HTMLElement>('.step-panel');

    ScrollTrigger.matchMedia({
      // Desktop: pin the section and slide the panels sideways as the page scrolls
      '(min-width: 1024px)': () => {
        const distance = () => track.scrollWidth - innerWidth;
        const tween = gsap.to(track, {
          x: () => -distance(), ease: 'none',
          scrollTrigger: {
            trigger: section, pin: true, scrub: 0.6, invalidateOnRefresh: true,
            end: () => `+=${distance()}`,
          },
        });
        gsap.to('.hscroll-progress', { scaleX: 1, ease: 'none', scrollTrigger: { trigger: section, start: 'top top', end: () => `+=${distance()}`, scrub: true } });
        // Overview chips: jump to the scroll position where that panel slides into view
        const chips = [...document.querySelectorAll<HTMLAnchorElement>('a[href^="#step-"]')];
        const onChip = (e: MouseEvent) => {
          const panel = document.querySelector<HTMLElement>((e.currentTarget as HTMLAnchorElement).hash);
          if (!panel) return;
          e.preventDefault();
          const st = tween.scrollTrigger!;
          const offset = Math.min(panel.offsetLeft - track.offsetLeft - innerWidth * 0.08, distance());
          scrollTo({ top: st.start + Math.max(0, offset), behavior: 'smooth' });
        };
        chips.forEach((c) => c.addEventListener('click', onChip));

        // Big step numbers drift against the slide for depth
        panels.forEach((p) => {
          gsap.fromTo(p.querySelector('.step-num'), { xPercent: 30 }, {
            xPercent: -30, ease: 'none',
            scrollTrigger: { trigger: p, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true },
          });
        });
        return () => chips.forEach((c) => c.removeEventListener('click', onChip));
      },
      // Mobile: panels rise in one by one
      '(max-width: 1023px)': () => {
        panels.forEach((p) => gsap.from(p, { y: 50, opacity: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: p, start: 'top 85%', once: true } }));
      },
    });
  }
</script>
