---
import Base from '../layouts/Base.astro';
import { site, markets } from '../data/site';
import ContactForm from '../components/ContactForm.astro';

const title = 'Contact AR Medias | Get a Free Quote for Your Project';
const description = `Talk to AR Medias about your website, app, CRM/ERP or AI automation project. Call ${site.phone}, email ${site.email}, WhatsApp us or visit our office in Kirti Nagar, New Delhi.`;

const mapQuery = encodeURIComponent(`AR Medias, ${site.address.street}, ${site.address.locality}, ${site.address.countryName}`);

const channels = [
  { label: 'Call us', value: site.phone, href: `tel:${site.phoneE164}`, icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z' },
  { label: 'WhatsApp', value: 'Chat with us now', href: site.whatsapp, icon: 'M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z' },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'M4 4h16v16H4zM4 6l8 7 8-7' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: `${site.url}/contact/`,
    mainEntity: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
    ],
  },
];
---

<Base {title} {description} {schema} hideContact>
  <section class="relative overflow-hidden pb-24 pt-32 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="blob absolute -right-24 -top-24 size-[36rem] rounded-full bg-olive-300/35 blur-3xl"></div>
      <div class="blob absolute -left-24 bottom-0 size-[28rem] rounded-full bg-navy/10 blur-3xl"></div>
    </div>
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_1.15fr]">
      <!-- Left: intro and direct channels -->
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-slate" data-hero><a href="/" class="hover:text-olive">Home</a> / <span>Contact</span></nav>
        <p class="eyebrow mt-6" data-hero>Contact</p>
        <h1 class="mt-4 text-5xl font-bold leading-[1.03] sm:text-6xl" data-hero>Let's talk about your <span class="text-olive">project.</span></h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate" data-hero>Tell us what you need. We reply within one business day with next steps, and the first consultation is free.</p>

        <ul class="mt-10 grid gap-3" data-reveal="stagger">
          {channels.map((c) => (
            <li>
              <a href={c.href} data-tilt class="group flex items-center gap-5 rounded-3xl bg-white p-5 ring-1 ring-navy/8 transition-colors hover:bg-navy" rel={c.href.startsWith('http') ? 'noopener' : undefined} target={c.href.startsWith('http') ? '_blank' : undefined}>
                <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-olive/10 text-olive transition-colors group-hover:bg-olive group-hover:text-white">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={c.icon} /></svg>
                </span>
                <span>
                  <span class="block text-sm text-slate group-hover:text-white/60">{c.label}</span>
                  <span class="block font-display text-lg font-semibold text-navy group-hover:text-white">{c.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-8 rounded-3xl bg-navy p-6 text-white" data-reveal="up">
          <p class="text-sm uppercase tracking-wider text-ember-300">Office</p>
          <address class="mt-2 not-italic leading-relaxed">{site.address.street},<br />{site.address.locality}, {site.address.countryName}</address>
          <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} class="mt-3 inline-block font-semibold text-olive-300 hover:text-white" rel="noopener" target="_blank">Get directions →</a>
        </div>
      </div>

      <!-- Right: form -->
      <div class="relative" data-reveal="up">
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- Map, loaded only when scrolled near -->
  <section class="container-x pb-24" aria-label="Office location map">
    <div class="overflow-hidden rounded-[2rem] ring-1 ring-navy/8">
      <iframe
        title="AR Medias office location, Kirti Nagar, New Delhi"
        src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-[22rem] w-full border-0 grayscale-[0.4] sm:h-[28rem]"></iframe>
    </div>
  </section>
</Base>



<script>
  import { gsap } from 'gsap';
  if (document.documentElement.classList.contains('js-motion')) {
    gsap.from('[data-hero]', { y: 30, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.1 });
  }
</script>
