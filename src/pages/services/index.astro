---
import Base from '../../layouts/Base.astro';
import { site, pillars } from '../../data/site';
import { serviceBySlug } from '../../data/services';

const title = 'IT Services | Web, App, CRM/ERP & AI Automation Development | AR Medias';
const description =
  'Explore AR Medias services: website development, mobile apps, e-commerce, UI/UX design, custom CRM and ERP software, AI automation and ongoing maintenance, all from one team.';

const groups = pillars.map((p) => ({
  ...p,
  services: p.items.map((i) => serviceBySlug[i.href.split('/')[2]]),
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: groups.flatMap((g) => g.services).map((s, i) => ({
      '@type': 'ListItem', position: i + 1, name: s.name, url: `${site.url}/services/${s.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <section class="relative overflow-hidden pb-16 pt-32 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="blob absolute -right-24 -top-24 size-[36rem] rounded-full bg-olive-300/35 blur-3xl"></div>
      <div class="blob absolute -left-20 bottom-0 size-[24rem] rounded-full bg-navy/10 blur-3xl"></div>
    </div>
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-slate" data-hero><a href="/" class="hover:text-olive">Home</a> / <span>Services</span></nav>
      <p class="eyebrow mt-6" data-hero>Services</p>
      <h1 class="mt-4 max-w-4xl text-5xl font-bold leading-[1.03] sm:text-6xl xl:text-7xl" data-hero>
        Every kind of software your business needs, <span class="text-olive">from one team.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate" data-hero>
        Websites, apps, CRM and ERP systems, AI automation and long-term support. {site.projectsDelivered}+ projects delivered for businesses across seven countries.
      </p>
      <nav aria-label="Service groups" class="mt-10 flex flex-wrap gap-2" data-hero>
        {groups.map((g, i) => (
          <a href={`#${g.key}`} class="rounded-full border border-navy/10 bg-white px-5 py-2.5 text-sm font-semibold text-navy transition-colors hover:border-olive hover:bg-olive hover:text-white">
            <span class="text-olive">0{i + 1}</span> {g.title}
          </a>
        ))}
      </nav>
    </div>
  </section>

  {groups.map((g, i) => (
    <section id={g.key} class={`scroll-mt-24 py-20 lg:py-24 ${i % 2 ? 'bg-mist/60' : ''}`}>
      <div class="container-x grid gap-10 lg:grid-cols-[1fr_2fr]">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <span class="font-display text-7xl font-bold text-olive/20" data-reveal="fade">0{i + 1}</span>
          <h2 class="mt-2 text-4xl font-bold sm:text-5xl">{g.title}</h2>
          <p class="mt-4 max-w-sm text-lg text-slate" data-reveal="up">{g.lead}</p>
        </div>
        <ul class="grid gap-5 sm:grid-cols-2" data-reveal="stagger">
          {g.services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} data-tilt class="group flex h-full flex-col rounded-3xl bg-white p-8 ring-1 ring-navy/8 transition-shadow hover:shadow-2xl hover:shadow-navy/10">
                <span class="grid size-14 place-items-center rounded-2xl bg-navy text-olive-300 transition-colors duration-300 group-hover:bg-olive group-hover:text-white">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
                </span>
                <h3 class="mt-6 text-2xl font-bold">{s.name}</h3>
                <p class="mt-3 flex-1 leading-relaxed text-slate">{s.lead}</p>
                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {s.tech.slice(0, 4).map((t) => <li class="rounded-full bg-mist px-3 py-1 text-xs font-medium text-navy/70">{t}</li>)}
                </ul>
                <span class="mt-6 inline-flex items-center gap-2 font-semibold text-olive">
                  Explore {s.name.toLowerCase()}
                  <svg class="transition-transform group-hover:translate-x-1" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="container-x py-24">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-navy px-8 py-16 text-center text-white sm:px-16 lg:py-20" data-reveal="up">
      <div aria-hidden="true" class="blob pointer-events-none absolute -right-20 -top-20 size-80 rounded-full bg-olive/40 blur-3xl"></div>
      <h2 class="relative mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl">Not sure which service you need?</h2>
      <p class="relative mx-auto mt-5 max-w-xl text-lg text-white/75">Tell us the problem. We'll recommend the simplest solution that works, even if it's a smaller project.</p>
      <div class="relative mt-9 flex flex-wrap justify-center gap-3">
        <a href="/contact/" class="btn-ember" data-magnetic>Book a free call</a>
        <a href={site.whatsapp} class="btn border-2 border-white/30 text-white hover:border-white" rel="noopener" target="_blank">WhatsApp us</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  if (document.documentElement.classList.contains('js-motion')) {
    gsap.from('[data-hero]', { y: 30, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.1 });
  }
</script>
