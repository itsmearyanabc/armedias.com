---
// Private preview of animated hero backgrounds in AR Medias colours, for choosing which
// one to use. Not linked from the site, not indexed, not in the sitemap.
import Base from '../layouts/Base.astro';

const effects = [
  { key: 'waves', name: 'Waves', note: 'Current homepage background. Calm, premium, moves with the mouse.' },
  { key: 'birds', name: 'Birds', note: 'Flocking birds in orange and green. Echoes the bird in your logo.' },
  { key: 'net', name: 'Network', note: 'Connected nodes. Reads as "systems, data, integration".' },
  { key: 'globe', name: 'Globe', note: 'Rotating connected globe. Fits "serving 7 countries".' },
  { key: 'fog', name: 'Fog', note: 'Slow flowing colour clouds in orange, gold and green.' },
  { key: 'halo', name: 'Halo', note: 'Glowing ring that follows the cursor. Very modern.' },
  { key: 'cells', name: 'Cells', note: 'Organic cell pattern. Abstract and colourful.' },
  { key: 'rings', name: 'Rings', note: 'Concentric tech rings. Futuristic.' },
];
---

<Base title="Animation Lab | AR Medias" description="Preview of animated backgrounds." noindex hideContact>
  <section class="pb-10 pt-28">
    <div class="container-x">
      <p class="eyebrow">Animation lab · private preview</p>
      <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Pick a background animation</h1>
      <p class="mt-3 max-w-2xl text-slate">Each effect is shown in your brand colours behind a sample hero. Move your mouse over the preview. Tell me which one you like for the homepage, or for other pages.</p>
      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Effects">
        {effects.map((e, i) => <button data-effect={e.key} aria-pressed={i === 0 ? 'true' : 'false'} class="fx-btn">{e.name}</button>)}
      </div>
      <p data-note class="mt-4 min-h-6 font-medium text-navy">{effects[0].note}</p>
    </div>
  </section>

  <section class="container-x pb-24">
    <div class="relative isolate overflow-hidden rounded-[2rem] shadow-2xl shadow-navy/30">
      <div id="fx-stage" class="absolute inset-0 -z-10 bg-navy"></div>
      <div class="pointer-events-none relative px-8 py-24 text-white sm:px-14 lg:py-32">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">IT company · New Delhi · Since 2024</p>
        <p class="mt-4 max-w-2xl font-display text-4xl font-bold leading-tight sm:text-6xl">The technology partner behind your <span class="text-shimmer">business growth.</span></p>
        <span class="btn-ember pointer-events-auto mt-8">Get your free consultation</span>
      </div>
      <p data-status class="absolute bottom-4 right-5 rounded-full bg-black/40 px-3 py-1 text-xs text-white">Loading…</p>
    </div>
  </section>
</Base>

<style>
  .fx-btn { border-radius: 999px; border: 1px solid rgb(19 33 58 / 0.12); background: #fff; padding: 0.6rem 1.2rem;
    font-weight: 600; font-size: 0.9rem; color: var(--color-navy); transition: all 0.2s; }
  .fx-btn:hover { border-color: var(--color-ember); color: var(--color-ember-600); }
  .fx-btn[aria-pressed='true'] { background: var(--color-ember); border-color: var(--color-ember); color: var(--color-navy); }
</style>

<script>
  type Effect = { destroy(): void };
  type Factory = (o: Record<string, unknown>) => Effect;

  const NAVY = 0x13213a, GREEN = 0x204a2b, OLIVE = 0xa9c46c, EMBER = 0xff7a1a, SUN = 0xffc93c;
  // (Vanta's "dots" effect is left out: it requires a global THREE and fails when bundled.)

  // Static import strings so the bundler can split each effect into its own file
  const effects: Record<string, { load: () => Promise<unknown>; opts: Record<string, unknown> }> = {
    waves: { load: () => import('vanta/dist/vanta.waves.min.js'), opts: { color: GREEN } },
    birds: { load: () => import('vanta/dist/vanta.birds.min.js'), opts: { backgroundColor: NAVY, color1: EMBER, color2: OLIVE, colorMode: 'lerp', birdSize: 1.3, quantity: 3.5, wingSpan: 25 } },
    net: { load: () => import('vanta/dist/vanta.net.min.js'), opts: { color: EMBER, backgroundColor: NAVY, points: 11, maxDistance: 22, spacing: 17 } },
    globe: { load: () => import('vanta/dist/vanta.globe.min.js'), opts: { color: EMBER, color2: OLIVE, backgroundColor: NAVY, size: 1.1 } },
    fog: { load: () => import('vanta/dist/vanta.fog.min.js'), opts: { highlightColor: SUN, midtoneColor: EMBER, lowlightColor: GREEN, baseColor: NAVY, blurFactor: 0.6, speed: 1.2 } },
    halo: { load: () => import('vanta/dist/vanta.halo.min.js'), opts: { baseColor: GREEN, backgroundColor: NAVY, amplitudeFactor: 1.4, size: 1.2 } },
    cells: { load: () => import('vanta/dist/vanta.cells.min.js'), opts: { color1: GREEN, color2: EMBER, size: 1.6, speed: 1.2 } },
    rings: { load: () => import('vanta/dist/vanta.rings.min.js'), opts: { backgroundColor: NAVY, color: EMBER } },
  };
  const notes = Object.fromEntries([...document.querySelectorAll<HTMLButtonElement>('[data-effect]')].map((b) => [b.dataset.effect!, b]));

  const stage = document.getElementById('fx-stage')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const note = document.querySelector<HTMLElement>('[data-note]')!;
  const noteText: Record<string, string> = {
    waves: 'Current homepage background. Calm, premium, moves with the mouse.',
    birds: 'Flocking birds in orange and green. Echoes the bird in your logo.',
    net: 'Connected nodes. Reads as "systems, data, integration".',
    globe: 'Rotating connected globe. Fits "serving 7 countries".',
    fog: 'Slow flowing colour clouds in orange, gold and green.',
    halo: 'Glowing ring that follows the cursor. Very modern.',
    cells: 'Organic cell pattern. Abstract and colourful.',
    rings: 'Concentric tech rings. Futuristic.',
  };

  let current: Effect | undefined;
  let token = 0;

  async function show(key: string) {
    const mine = ++token;
    status.textContent = 'Loading…';
    // A failed effect can leave a broken instance; never let that block the next one
    try { current?.destroy(); } catch { /* already torn down */ }
    current = undefined;
    stage.replaceChildren();
    const [THREE, mod] = await Promise.all([import('three'), effects[key].load()]);
    if (mine !== token) return;
    const m = mod as { default: Factory | { default: Factory } };
    const factory = typeof m.default === 'function' ? m.default : m.default.default;
    current = factory({ el: stage, THREE, mouseControls: true, touchControls: true, gyroControls: false, minHeight: 200, minWidth: 200, scale: 1, scaleMobile: 1, ...effects[key].opts });
    status.textContent = `${notes[key].textContent} · move your mouse`;
  }

  Object.entries(notes).forEach(([key, btn]) => btn.addEventListener('click', () => {
    Object.values(notes).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    note.textContent = noteText[key];
    show(key);
  }));

  show('waves');
</script>
