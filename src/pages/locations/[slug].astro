---
import Base from '../../layouts/Base.astro';
import Skyline from '../../components/skylines/Skyline.astro';
import { site, pillars, markets } from '../../data/site';
import { delhiServices } from '../../data/delhi';
import { cityPageFor } from '../../data/cities';
import { worldCitiesFor } from '../../data/world-cities';
import { russiaCities } from '../../data/russia-cities';
import { delhiWorkingStyle, remoteWorkingStyle } from '../../data/working-style';
import WorkingStyle from '../../components/WorkingStyle.astro';
import { marketGuides } from '../../data/market-guides';
import { costGuides } from '../../data/cost-guides';

export function getStaticPaths() {
  return markets.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
// Market-specific sections (hours table, hiring checklist, local requirements), where written.
const guide = marketGuides[m.slug];
const services = pillars.flatMap((p) => p.items);
const others = markets.filter((x) => x.slug !== m.slug);
// City pages for this market (outside India); the city chips below link to them.
const cityPages: { name: string; slug: string; tz: string }[] = m.slug === 'russia'
  ? russiaCities.map((c) => ({ name: c.nameEn, slug: c.slug, tz: c.tz }))
  : worldCitiesFor(m.slug);
const listed = new Set(m.cities.map((c) => c.name));
const extraCities = cityPages.filter((c) => !listed.has(c.name));

// Most markets search by country; the UAE searches by Dubai first.
const title = guide?.metaTitle ?? `Software & App Development Company in ${m.titlePlace ?? m.country} | AR Medias`;
const description = guide?.metaDescription ?? `Websites, apps, CRM/ERP and AI automation for businesses in ${m.area}. Fixed quotes in ${m.currency} and calls in your time zone.`;

const faqs = [
  m.faq,
  { q: `Do you work with businesses in ${m.country}?`, a: `Yes. We work with clients across ${m.area}. Projects run remotely, with calls scheduled during ${m.city} business hours and billing in ${m.currency}.` },
  { q: `How do you handle data privacy for ${m.country} projects?`, a: `We design data storage, consent and access controls with ${m.privacyLaw} in mind, and can host data in the region you require.` },
  // A guide answers cost questions itself, in the wording buyers in that market search for.
  ...(guide ? guide.faqs : [{ q: `How much does software development cost for ${m.country} businesses?`, a: `It depends on the scope, features and integrations. After a free call we send a written scope with a fixed price in ${m.currency}, so the cost does not change midway.` }]),
  { q: 'How do we get started?', a: 'Book a free 30-minute call. We review your goals and send a written scope with a fixed quote and timeline.' },
];

// Show a clock on each city only when the market spans several time zones.
const multiTz = new Set(m.cities.map((c) => c.tz)).size > 1;
// The India page leads with in-person meetings (our office is in New Delhi).
const workingStyle = m.slug === 'india' ? delhiWorkingStyle : remoteWorkingStyle({ city: m.city, currency: m.currency });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Software, app and AI automation development in ${m.country}`,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: m.schemaName },
    serviceType: services.map((s) => s.name),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: m.country, item: `${site.url}/locations/${m.slug}/` },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <section class="relative overflow-hidden pb-20 pt-32 lg:pt-40">
    <div aria-hidden="true" class="blob pointer-events-none absolute -right-32 -top-20 -z-10 size-[36rem] rounded-full bg-olive-300/30 blur-3xl"></div>
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
      <nav aria-label="Breadcrumb" class="text-sm text-slate"><a href="/" class="hover:text-olive">Home</a> / <span>{m.country}</span></nav>
      <p class="eyebrow mt-6">{m.city} · <time data-clock={m.tz}>--:--</time> local time</p>
      <h1 class="mt-4 max-w-4xl text-5xl font-bold leading-[1.05] sm:text-6xl lg:text-5xl xl:text-6xl">{guide ? guide.h1 : `Software, app & AI automation company for ${m.country}`}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate">{m.intro}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact/" class="btn-primary" data-magnetic>Book a free call</a>
        <a href="/work/" class="btn-ghost">See our work</a>
      </div>
      </div>
      <Skyline slug={m.slug as any} tz={m.tz} city={m.city} />
    </div>
  </section>

  <section class="bg-mist/60 py-20">
    <div class="container-x">
      <h2 class="text-3xl font-bold sm:text-4xl" data-reveal="up">What we build for {m.country} businesses</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
        {services.map((s) => (
          <li><a href={s.href} class="flex items-center justify-between rounded-2xl bg-white px-6 py-5 font-semibold ring-1 ring-navy/5 transition-colors hover:bg-olive hover:text-white">{s.name}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <p class="eyebrow" data-reveal="fade">Cities we work with</p>
      <h2 class="mt-4 text-3xl font-bold sm:text-4xl">Working with businesses across {m.country}.</h2>
      <p class="mt-4 max-w-2xl text-lg text-slate">{m.slug === 'india'
        ? 'Projects run on Google Meet with regular update meetings and timely follow-ups. Delhi NCR clients can also meet us in person at our Kirti Nagar office.'
        : `Calls are scheduled inside your working hours on Google Meet, with regular project update meetings and timely follow-ups.${multiTz ? ' Local time now:' : ''}`}</p>
      <ul class="mt-8 flex flex-wrap gap-2" data-reveal="stagger">
        {m.cities.map((c) => (
          <li>
            {m.slug === 'india' && c.name === 'Delhi NCR'
              ? <a href="/locations/delhi/" class="inline-flex items-center gap-2 rounded-full bg-navy px-4 py-2 font-semibold text-white hover:bg-olive">{c.name} <span aria-hidden="true">→</span></a>
              : m.slug === 'india' && cityPageFor(c.name)
                ? <a href={`/locations/india/${cityPageFor(c.name)!.slug}/`} class="inline-flex items-center gap-2 rounded-full border border-navy/10 px-4 py-2 font-medium text-navy hover:border-olive hover:text-olive">{c.name} <span aria-hidden="true">→</span></a>
                : cityPages.find((p) => p.name === c.name)
                  ? <a href={`/locations/${m.slug}/${cityPages.find((p) => p.name === c.name)!.slug}/`} class="inline-flex items-center gap-2 rounded-full border border-navy/10 px-4 py-2 font-medium text-navy hover:border-olive hover:text-olive">{c.name}{multiTz && <time class="text-sm text-slate" data-clock={c.tz}>--:--</time>} <span aria-hidden="true">→</span></a>
                  : <span class="inline-flex items-center gap-2 rounded-full border border-navy/10 px-4 py-2 font-medium text-navy">{c.name}{multiTz && <time class="text-sm text-slate" data-clock={c.tz}>--:--</time>}</span>}
          </li>
        ))}
        {extraCities.map((c) => (
          <li><a href={`/locations/${m.slug}/${c.slug}/`} class="inline-flex items-center gap-2 rounded-full border border-navy/10 px-4 py-2 font-medium text-navy hover:border-olive hover:text-olive">{c.name}{multiTz && <time class="text-sm text-slate" data-clock={c.tz}>--:--</time>} <span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <WorkingStyle items={workingStyle} heading={m.slug === 'india' ? undefined : `How we work with ${m.country} businesses.`} />

  {guide?.hours && (
    <section class="py-20">
      <div class="container-x">
        <p class="eyebrow" data-reveal="fade">Time zones</p>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">{guide.hours.heading}</h2>
        <p class="mt-4 max-w-2xl text-lg text-slate">{guide.hours.lead}</p>
        <div class="mt-8 overflow-x-auto rounded-2xl ring-1 ring-navy/10">
          <table class="w-full min-w-[36rem] text-left">
            <thead class="bg-mist text-sm uppercase tracking-wider text-slate">
              <tr><th class="px-5 py-3 font-semibold">US time zone</th><th class="px-5 py-3 font-semibold">New Delhi is ahead by (winter)</th><th class="px-5 py-3 font-semibold">(summer)</th></tr>
            </thead>
            <tbody class="divide-y divide-navy/10">
              {guide.hours.zones.map((z) => (
                <tr><td class="px-5 py-4"><span class="font-semibold text-navy">{z.name}</span><span class="block text-sm text-slate">{z.example}</span></td><td class="px-5 py-4 text-navy">{z.standard}</td><td class="px-5 py-4 text-navy">{z.daylight}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 max-w-2xl text-sm text-slate">{guide.hours.note}</p>
      </div>
    </section>
  )}

  {guide && (
    <section class="bg-mist/60 py-20">
      <div class="container-x">
        <p class="eyebrow" data-reveal="fade">{guide.checklist.eyebrow}</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold sm:text-4xl">{guide.checklist.heading}</h2>
        <p class="mt-4 max-w-2xl text-lg text-slate">{guide.checklist.lead}</p>
        <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
          {guide.checklist.items.map((it, i) => (
            <li class="rounded-2xl bg-white p-6 ring-1 ring-navy/5">
              <p class="font-display text-sm font-semibold text-olive">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-xl font-semibold">{it.t}</h3>
              <p class="mt-2 leading-relaxed text-slate">{it.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {guide && (
    <section class="py-20">
      <div class="container-x">
        <h2 class="text-3xl font-bold sm:text-4xl">{guide.requirements.heading}</h2>
        <div class="mt-10 grid gap-8 sm:grid-cols-2" data-reveal="stagger">
          {guide.requirements.items.map((it) => (
            <div><h3 class="text-xl font-semibold">{it.t}</h3><p class="mt-2 leading-relaxed text-slate">{it.d}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-b border-navy/8 py-10">
    <div class="container-x">
      <p class="text-lg text-slate">Need developers on your own team instead of a project? <a href="/hire-dedicated-developers/" class="font-semibold text-olive hover:text-navy">Hire dedicated developers →</a></p>
    </div>
  </section>

  {costGuides.filter((g) => g.markets.some((x) => x.slug === m.slug)).map((g) => {
    return (
      <section class="py-10">
        <div class="container-x">
          <a href={`/pricing/${g.slug}/#${m.slug}`} class="group relative flex flex-col gap-5 overflow-hidden rounded-[2rem] bg-navy p-8 text-white sm:flex-row sm:items-center sm:justify-between sm:p-10" data-reveal="up">
            <span aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 size-56 rounded-full bg-ember/25 blur-3xl"></span>
            <span class="relative">
              <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-ember-300">Cost guide 2026</span>
              <span class="mt-2 block font-display text-2xl font-bold sm:text-3xl">What a {g.short} costs in {m.country}</span>
              <span class="mt-2 block max-w-xl text-white/70">What shapes the cost in {m.country}, and a planner that sends your plan and budget to us on WhatsApp.</span>
            </span>
            <span class="btn-ember relative shrink-0">Plan my website <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
          </a>
        </div>
      </section>
    );
  })}

  {m.slug === 'india' && (
    <section class="py-20">
      <div class="container-x">
        <p class="eyebrow" data-reveal="fade">Based in New Delhi</p>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">In Delhi NCR? Meet us in person.</h2>
        <p class="mt-4 max-w-2xl text-lg text-slate">Our office is in Kirti Nagar. See how we work with <a href="/locations/delhi/" class="font-semibold text-olive hover:text-navy">businesses in Delhi →</a></p>
        <ul class="mt-8 flex flex-wrap gap-2" data-reveal="stagger">
          {delhiServices.map((d) => <li><a href={`/locations/delhi/${d.slug}/`} class="inline-block rounded-full border border-navy/10 px-4 py-2 text-sm font-medium hover:border-olive hover:text-olive">{d.name} in Delhi</a></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="py-20">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow" data-reveal="fade">Built for {m.country}</p>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">What {m.country} businesses often need.</h2>
        <ul class="mt-8 space-y-3" data-reveal="stagger">
          {m.needs.map((n) => (
            <li class="flex items-start gap-3 text-lg text-slate">
              <span class="mt-1.5 grid size-5 shrink-0 place-items-center rounded-full bg-gradient-to-br from-ember to-sun text-navy">
                <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 4 8-9" /></svg>
              </span>{n}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow" data-reveal="fade">Integrations</p>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">Connected to the tools you use in {m.country}.</h2>
        <ul class="mt-8 flex flex-wrap gap-2" data-reveal="stagger">
          {m.integrations.map((t) => <li class="rounded-full bg-mist px-4 py-2 font-medium text-navy ring-1 ring-navy/5 transition-colors hover:bg-ember">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="container-x grid gap-10 lg:grid-cols-3" data-reveal="stagger">
      <div data-tilt class="rounded-3xl bg-navy p-8 text-white">
        <p class="text-sm uppercase tracking-wider text-ember-300">Time zone</p>
        <p class="mt-3 font-display text-2xl font-bold">Calls in {m.city} hours</p>
        <p class="mt-2 text-white/70">Delhi now: <time data-clock="Asia/Kolkata">--:--</time> · {m.city}: <time data-clock={m.tz}>--:--</time></p>
      </div>
      <div data-tilt class="rounded-3xl bg-mist p-8">
        <p class="text-sm uppercase tracking-wider text-olive">Billing</p>
        <p class="mt-3 font-display text-2xl font-bold">Fixed quotes in {m.currency}</p>
        <p class="mt-2 text-slate">Milestone-based payments, written scope before work begins.</p>
      </div>
      <div data-tilt class="rounded-3xl bg-mist p-8">
        <p class="text-sm uppercase tracking-wider text-olive">Privacy</p>
        <p class="mt-3 font-display text-2xl font-bold">{m.privacyLaw}</p>
        <p class="mt-2 text-slate">Consent, storage and access designed with local rules in mind.</p>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <h2 class="text-3xl font-bold sm:text-4xl">Questions from {m.country} clients</h2>
      <div class="divide-y divide-navy/10 border-y border-navy/10">
        {faqs.map((f) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-semibold">{f.q}<span class="grid size-9 shrink-0 place-items-center rounded-full bg-mist transition-transform group-open:rotate-45">+</span></summary>
            <p class="mt-4 leading-relaxed text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-navy/10 py-12">
    <div class="container-x">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate">We also work in</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {others.map((o) => <li><a href={`/locations/${o.slug}/`} class="inline-block rounded-full border border-navy/10 px-4 py-2 text-sm font-medium hover:border-olive hover:text-olive">{o.country}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((el) => {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: el.dataset.clock, hour: '2-digit', minute: '2-digit' });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  });
</script>
