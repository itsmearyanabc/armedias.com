---
import Base from '../../../layouts/Base.astro';
import BlogList from '../../../components/BlogList.astro';
import { categories } from '../../../content.config';
import { getPosts } from '../../../lib/blog';

// Pages exist only for categories with published articles, so no empty pages get indexed
export async function getStaticPaths() {
  const used = new Set((await getPosts()).map((p) => p.data.category));
  return [...used].map((category) => ({ params: { category } }));
}

const category = Astro.params.category as keyof typeof categories;
const name = categories[category];
const posts = (await getPosts()).filter((p) => p.data.category === category);

// Category-specific description and intro, so each listing page says what it covers
const intros: Record<string, { description: string; lead: string }> = {
  crm: {
    description: 'CRM guides for sales teams: custom CRM vs Zoho, HubSpot and Salesforce, lead capture, follow-ups and choosing the right CRM.',
    lead: 'How to choose, plan and get value from a CRM: custom builds, Zoho, HubSpot and Salesforce, lead capture from every channel and follow-ups that do not slip.',
  },
  erp: {
    description: 'ERP guides for manufacturers, traders and distributors: custom ERP vs Odoo, ERPNext and Tally, GST, inventory and how to avoid a failed rollout.',
    lead: 'Practical advice on ERP for growing businesses: when Tally is enough, how Odoo and ERPNext compare, when a custom ERP pays off and how to roll it out without disruption.',
  },
  'ai-automation': {
    description: 'Guides to AI and WhatsApp automation: what to automate, WhatsApp Business API rules, AI chatbots and connecting it all to your CRM.',
    lead: 'What AI and automation can take off your team, from instant WhatsApp replies and lead capture to AI assistants, and the rules to follow when you set it up.',
  },
  'web-apps': {
    description: 'Guides to websites and apps: Core Web Vitals and site speed, planning an MVP, web vs mobile, and building products that grow.',
    lead: 'How to plan, build and speed up websites and apps: Core Web Vitals, choosing what goes into a first version, web or mobile, and foundations worth getting right.',
  },
};
const intro = intros[category];
---

<Base
  title={`${name} Articles & Guides | AR Medias Blog`}
  description={intro?.description ?? `Practical ${name} guides for business owners: costs, comparisons and step-by-step advice from the AR Medias team.`}
>
  <BlogList
    {posts}
    active={category}
    heading={`${name} guides`}
    lead={intro?.lead ?? `Everything we've written about ${name}, with practical advice you can use today.`}
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name }]}
  />
</Base>
