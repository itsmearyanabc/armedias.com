---
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/illustrations/Illustration.astro';
import Scribble from '../../components/Scribble.astro';
import { site, markets } from '../../data/site';
import { serviceBySlug } from '../../data/services';
import { industries, type Industry } from '../../data/industries';
import { costGuides } from '../../data/cost-guides';
import { withArticle } from '../../lib/cost-format';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return industries.map((i) => ({ params: { slug: i.slug }, props: { ind: i } }));
}

const { ind } = Astro.props as { ind: Industry };
const url = `${site.url}/industries/${ind.slug}/`;
const related = ind.services.map((s) => serviceBySlug[s]);
const others = industries.filter((i) => i.slug !== ind.slug);
const lower = ind.name.toLowerCase();
const guides = costGuides.filter((g) => ind.services.includes(g.service));
const work = projects.filter((p) => p.services.some((x) => ind.services.includes(x))).slice(0, 3);
// The headline with its accent phrase split out, so it can be drawn with the orange underline
const hasAccent = !!ind.accent && ind.headline.includes(ind.accent);
const [before, after] = hasAccent ? ind.headline.split(ind.accent!) : [ind.headline, ''];
const trust = ['Free first call', 'Fixed quote before work starts', 'You own the code'];
const steps = [
  { t: 'A free 30-minute call', d: `Tell us how your ${lower} business runs today and where time or money leaks.` },
  { t: 'A written scope and fixed quote', d: 'You see exactly what will be built, in what order and for how much, before anything starts.' },
  { t: 'Built in phases you can see', d: 'Weekly demos, the most useful part first, so your team starts saving time early.' },
];
const wa = `${site.whatsapp}?text=${encodeURIComponent(`Hi AR Medias, I run a ${lower} business and I'd like to talk about software for it.`)}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Software development for ${ind.name}`,
    description: ind.metaDescription,
    url,
    provider: { '@id': `${site.url}/#organization` },
    audience: { '@type': 'BusinessAudience', name: ind.name },
    areaServed: markets.map((m) => ({ '@type': 'Country', name: m.schemaName })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ind.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: `${site.url}/industries/` },
      { '@type': 'ListItem', position: 3, name: ind.name, item: url },
    ],
  },
];
---

<Base title={ind.metaTitle} description={ind.metaDescription} {schema}>
  <section class="relative overflow-hidden pb-16 pt-32 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="blob absolute -right-24 -top-24 size-[36rem] rounded-full bg-ember/20 blur-3xl"></div>
      <div class="blob absolute -left-24 bottom-0 size-[26rem] rounded-full bg-sun/25 blur-3xl"></div>
    </div>
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-slate" data-hero>
          <a href="/" class="hover:text-ember-600">Home</a> / <a href="/industries/" class="hover:text-ember-600">Industries</a> / <span>{ind.name}</span>
        </nav>
        <h1 class="eyebrow mt-6 font-sans text-ember-700!" data-hero><span class="size-2 animate-pulse rounded-full bg-ember"></span>{ind.h1 ?? ind.name}</h1>
        <p class="mt-4 font-display text-4xl font-bold leading-[1.08] tracking-tight text-balance text-ink sm:text-5xl xl:text-6xl" data-hero>
          {before}{hasAccent && <span class="text-ember-600"><Scribble>{ind.accent}</Scribble></span>}{after}
        </p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate" data-hero>{ind.lead}</p>
        <div class="mt-9 flex flex-wrap gap-3" data-hero>
          <a href="/contact/" class="btn-ember" data-magnetic>Get a free consultation</a>
          <a href="#what-we-build" class="btn-ghost">See what we build</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-navy" data-hero>
          {trust.map((t) => <li class="flex items-center gap-2"><span class="grid size-5 place-items-center rounded-full bg-ember text-[11px] text-navy">✓</span>{t}</li>)}
        </ul>
      </div>
      <div class="mx-auto w-full max-w-md" data-hero><Illustration name={ind.scene} title={`${ind.name} software illustration`} /></div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-mist/60 py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-ember-700!" data-reveal="fade">Sound familiar?</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">What slows {lower} businesses down.</h2>
        <p class="mt-5 text-lg text-slate" data-reveal="up">If two or more of these happen in your business every week, the right software usually pays for itself quickly.</p>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-2" data-reveal="stagger">
        {ind.challenges.map((c, i) => (
          <li data-tilt class="relative overflow-hidden rounded-3xl bg-white p-8 pl-10 shadow-sm ring-1 ring-navy/8 transition-shadow hover:shadow-xl hover:shadow-ember/10">
            <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-ember to-sun"></span>
            <span class="grid size-11 place-items-center rounded-2xl bg-ember/12 font-display text-sm font-bold text-ember-700">0{i + 1}</span>
            <h3 class="mt-4 text-2xl font-bold">{c.t}</h3>
            <p class="mt-3 leading-relaxed text-slate">{c.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-label="There is a simpler way" class="bg-gradient-to-r from-ember to-sun py-10 text-navy">
    <div class="container-x flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
      <p class="font-display text-2xl font-bold sm:text-3xl">There is a simpler way to run all of this.</p>
      <a href="#what-we-build" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">Show me how <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="what-we-build" class="relative scroll-mt-24 overflow-hidden bg-navy py-24 text-white">
    <div aria-hidden="true" class="blob pointer-events-none absolute -right-40 top-10 size-[30rem] rounded-full bg-ember/25 blur-3xl"></div>
    <div aria-hidden="true" class="blob pointer-events-none absolute -left-40 bottom-0 size-[24rem] rounded-full bg-sun/10 blur-3xl"></div>
    <div class="container-x relative">
      <div class="max-w-2xl">
        <p class="eyebrow text-ember-300!" data-reveal="fade">What we build</p>
        <h2 class="mt-4 text-4xl font-bold text-white sm:text-5xl">Systems made for {lower}.</h2>
        <p class="mt-5 text-lg text-white/70" data-reveal="up">Built around the way your team already works, so people actually use it.</p>
      </div>
      <ul class="mt-14 grid gap-5 md:grid-cols-2" data-reveal="stagger">
        {ind.builds.map((b) => (
          <li class="group rounded-3xl bg-white/6 p-8 ring-1 ring-white/10 transition-colors hover:bg-white/10 hover:ring-ember/50">
            <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-ember to-sun text-xl font-bold text-navy shadow-lg shadow-ember/30 transition-transform group-hover:-rotate-6">✓</span>
            <h3 class="mt-5 text-2xl font-bold text-white">{b.t}</h3>
            <p class="mt-3 leading-relaxed text-white/70">{b.d}</p>
          </li>
        ))}
      </ul>
      <div class="mt-12" data-reveal="up">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-300">Works with</p>
        <ul class="mt-4 flex flex-wrap gap-2">{ind.tools.map((t) => <li class="rounded-full bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/10">{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow text-ember-700!" data-reveal="fade">How we start</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Three easy steps, no risk.</h2>
      </div>
      <ol class="relative mt-14 grid gap-6 md:grid-cols-3" data-reveal="stagger">
        <span aria-hidden="true" class="absolute left-6 top-6 hidden h-0.5 w-[calc(100%-3rem)] bg-gradient-to-r from-ember via-sun to-ember/20 md:block"></span>
        {steps.map((st, i) => (
          <li class="relative">
            <span class="relative grid size-12 place-items-center rounded-full bg-ember font-display font-bold text-navy shadow-lg shadow-ember/30 ring-8 ring-white">{i + 1}</span>
            <h3 class="mt-5 text-xl font-bold">{st.t}</h3>
            <p class="mt-2 leading-relaxed text-slate">{st.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-mist/60 py-24">
    <div class="container-x">
      <h2 class="text-3xl font-bold sm:text-4xl">Services for {lower}</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3" data-reveal="stagger">
        {related.map((r) => (
          <li>
            <a href={`/services/${r.slug}/`} data-tilt class="group flex h-full flex-col rounded-3xl bg-white p-7 ring-1 ring-navy/8 transition-shadow hover:shadow-xl hover:shadow-ember/10">
              <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-ember to-sun text-navy">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={r.icon} /></svg>
              </span>
              <h3 class="mt-5 text-xl font-bold group-hover:text-ember-600">{r.name}</h3>
              <p class="mt-2 flex-1 text-slate">{r.lead}</p>
              <span class="mt-5 font-semibold text-ember-700">Learn more →</span>
            </a>
          </li>
        ))}
      </ul>
      {work.length > 0 && (
        <div class="mt-12">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember-700">Related work</p>
          <ul class="mt-4 grid gap-3 md:grid-cols-3">
            {work.map((p) => (
              <li><a href={`/work/${p.slug}/`} class="group flex h-full flex-col rounded-2xl bg-white p-5 ring-1 ring-navy/8 transition-shadow hover:shadow-lg hover:shadow-ember/10"><span class="text-xs font-semibold text-ember-700">{p.client || p.business}</span><span class="mt-1 font-display font-bold group-hover:text-ember-600">{p.title} <span aria-hidden="true">→</span></span></a></li>
            ))}
          </ul>
        </div>
      )}
      {guides.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-3">
          {guides.map((g) => (
            <li><a href={`/pricing/${g.slug}/`} class="inline-flex items-center gap-2 rounded-full bg-ember/10 px-5 py-2.5 text-sm font-semibold text-navy ring-1 ring-ember/25 transition-colors hover:bg-ember">What does {withArticle(g.short)} cost? <span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="container-x py-16">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-ember via-ember to-sun px-8 py-14 text-navy sm:px-14">
      <div aria-hidden="true" class="blob pointer-events-none absolute -right-16 -top-16 size-72 rounded-full bg-white/25 blur-3xl"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-navy/70">Not sure where to start?</p>
          <h2 class="mt-3 text-3xl font-bold text-navy sm:text-4xl">Tell us how your {lower} business runs today.</h2>
          <p class="mt-4 max-w-xl text-lg text-navy/80">On a free call we point out the one or two changes that would save your team the most time, whether or not you hire us.</p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white shadow-lg transition-transform hover:-translate-y-0.5" data-magnetic>Book a free call</a>
          <a href={wa} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-navy transition-transform hover:-translate-y-0.5" data-wa>WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="eyebrow text-ember-700!" data-reveal="fade">FAQ</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">{ind.name} questions.</h2>
      </div>
      <div class="divide-y divide-navy/10 border-y border-navy/10">
        {ind.faqs.map((f) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-semibold group-open:text-ember-700">
              {f.q}
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ember/12 text-ember-700 transition-transform duration-300 group-open:rotate-45 group-open:bg-ember group-open:text-navy">+</span>
            </summary>
            <p class="mt-4 max-w-2xl leading-relaxed text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-navy/10 py-12">
    <div class="container-x">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate">Other industries</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {others.map((o) => <li><a href={`/industries/${o.slug}/`} class="inline-block rounded-full border border-navy/10 px-4 py-2 text-sm font-medium transition-colors hover:border-ember hover:bg-ember hover:text-navy">{o.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  if (document.documentElement.classList.contains('js-motion')) {
    gsap.from('[data-hero]', { y: 30, opacity: 0, duration: 1, ease: 'power3.out', stagger: 0.1 });
  }
</script>
