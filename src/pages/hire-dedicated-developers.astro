---
import Base from '../layouts/Base.astro';
import RouteBackdrop from '../components/RouteBackdrop.astro';
import WorkingStyle from '../components/WorkingStyle.astro';
import ProjectCta from '../components/ProjectCta.astro';
import { site, markets } from '../data/site';
import { dedicated as p } from '../data/dedicated';

const url = `${site.url}${p.path}`;
// Benefits reuse the dark "How we work" section; icons follow the order of p.benefits.
const icons = [
  'M4 6h16M4 12h16M4 18h10',
  'M12 7v5l3 3M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
  'M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM12 10v11M12 15h4M12 19h3',
  'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6',
  'M15 10l5-3v10l-5-3M3 7h12v10H3z',
  'M4 12h16M12 4v16',
];
const benefits = p.benefits.map((b, i) => ({ ...b, icon: icons[i] }));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#service`,
    name: 'Dedicated developers',
    serviceType: 'Dedicated development team',
    description: p.metaDescription,
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: markets.map((m) => ({ '@type': 'Country', name: m.schemaName })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Hire dedicated developers', item: url },
    ],
  },
];
---

<Base title={p.metaTitle} description={p.metaDescription} {schema}>
  <!-- HERO -->
  <section class="relative overflow-hidden pb-16 pt-32 lg:pb-24 lg:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="blob absolute -right-24 -top-24 size-[36rem] rounded-full bg-olive-300/35 blur-3xl"></div>
      <div class="blob absolute bottom-0 left-1/4 size-[26rem] rounded-full bg-ember/10 blur-3xl"></div>
    </div>
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-slate" data-hero>
          <a href="/" class="hover:text-olive">Home</a> / <span>Hire dedicated developers</span>
        </nav>
        <p class="eyebrow mt-6" data-hero>Dedicated team · billed monthly</p>
        <h1 class="mt-4 text-4xl font-bold leading-[1.05] sm:text-5xl xl:text-6xl" data-hero>{p.h1}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate" data-hero>{p.lead}</p>
        <div class="mt-9 flex flex-wrap gap-3" data-hero>
          <a href="/contact/" class="btn-primary" data-magnetic>Tell us who you need</a>
          <a href="#roles" class="btn-ghost">Roles you can add</a>
        </div>
      </div>

      <!-- Your team, joined from New Delhi: role chips over the route map -->
      <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-navy via-[#1f3d2a] to-olive p-6 text-white shadow-2xl shadow-navy/25 sm:p-8" aria-hidden="true" data-reveal="up">
        <RouteBackdrop />
        <div class="relative">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember-300">Your team</p>
          <ul class="mt-5 space-y-3">
            {p.roles.slice(0, 4).map((r, i) => (
              <li class="team-chip flex items-center justify-between gap-4 rounded-2xl bg-white/10 px-4 py-3 ring-1 ring-white/15 backdrop-blur-sm" style={`--i:${i}`}>
                <span class="flex items-center gap-3">
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ember font-display text-sm font-bold text-navy">{r.abbr}</span>
                  <span class="font-semibold">{r.one}</span>
                </span>
                <span class="hidden text-xs text-white/70 sm:inline">{r.tech.slice(0, 2).join(' · ')}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 flex items-center gap-2 text-sm text-white/75"><span class="size-2 animate-pulse rounded-full bg-ember"></span> Working in your tools, with overlap in your day</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROLES -->
  <section id="roles" class="scroll-mt-24 bg-mist/60 py-24 lg:py-28">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade">Roles you can add</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Developers and designers for your stack.</h2>
        <p class="mt-5 text-lg text-slate" data-reveal="up">Tell us the technologies you use. We confirm the right people for your stack on the first call.</p>
      </div>
      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
        {p.roles.map((r) => (
          <li data-tilt class="group flex h-full flex-col rounded-3xl bg-white p-6 ring-1 ring-navy/5 transition-colors duration-300 hover:bg-navy sm:p-7">
            <h3 class="text-xl font-bold transition-colors group-hover:text-white">{r.t}</h3>
            <p class="mt-2 flex-1 leading-relaxed text-slate transition-colors group-hover:text-white/75">{r.d}</p>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {r.tech.map((t) => <li class="rounded-full bg-mist px-3 py-1 text-xs font-semibold text-navy transition-colors group-hover:bg-white/10 group-hover:text-white">{t}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="py-24 lg:py-28">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade">How it works</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">From first call to your first stand-up.</h2>
      </div>
      <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
        {p.steps.map((st, i) => (
          <li class="group relative overflow-hidden rounded-3xl bg-mist p-6 transition-colors duration-300 hover:bg-ember hover:text-navy">
            <span aria-hidden="true" class="font-display text-5xl font-bold text-navy/10 transition-colors group-hover:text-white/25">0{i + 1}</span>
            <h3 class="mt-4 text-xl font-bold group-hover:text-white">{st.t}</h3>
            <p class="mt-2 text-slate group-hover:text-white/85">{st.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <WorkingStyle items={benefits} heading="Your developers, your roadmap." />

  <!-- COMPARE -->
  <section class="py-24 lg:py-28">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade">Which model fits</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Dedicated developers or a fixed-price project?</h2>
      </div>
      <div class="mt-12 overflow-x-auto rounded-3xl ring-1 ring-navy/10" data-reveal="up">
        <table class="w-full min-w-[40rem] text-left">
          <thead>
            <tr class="bg-navy text-white">
              <th scope="col" class="px-5 py-4 text-sm font-semibold"><span class="sr-only">Compare</span></th>
              {p.compare.models.map((m, i) => <th scope="col" class:list={['px-5 py-4 font-display text-lg font-bold', i === 0 && 'text-ember-300']}>{m.t}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-navy/10">
            {p.compare.rows.map((row, r) => (
              <tr class="bg-white">
                <th scope="row" class="px-5 py-4 text-sm font-semibold uppercase tracking-wider text-slate">{row}</th>
                {p.compare.models.map((m, i) => <td class:list={['px-5 py-4', i === 0 ? 'font-semibold text-navy' : 'text-slate']}>{m.cells[r]}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-slate">See all three ways to work with us on the <a href="/pricing/" class="font-semibold text-olive hover:text-navy">pricing page →</a></p>
    </div>
  </section>

  <!-- COUNTRIES -->
  <section class="border-y border-navy/8 bg-mist/60 py-10">
    <div class="container-x flex flex-wrap items-center gap-3">
      <h2 class="mr-2 text-sm font-semibold uppercase tracking-[0.2em] text-slate" data-no-split>Teams we work with</h2>
      {markets.map((m) => <a href={`/locations/${m.slug}/`} class="rounded-full bg-white px-4 py-2 text-sm font-medium text-navy ring-1 ring-navy/5 hover:text-olive">{m.country}</a>)}
      <a href="/industries/software-companies/" class="rounded-full bg-white px-4 py-2 text-sm font-medium text-navy ring-1 ring-navy/5 hover:text-olive">Software and SaaS companies</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 lg:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="eyebrow" data-reveal="fade">FAQ</p>
        <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Hiring developers, answered.</h2>
      </div>
      <div class="divide-y divide-navy/10 border-y border-navy/10">
        {p.faqs.map((f) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-semibold">
              {f.q}
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-mist transition-transform duration-300 group-open:rotate-45 group-open:bg-olive group-open:text-white">+</span>
            </summary>
            <p class="mt-4 max-w-2xl leading-relaxed text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ProjectCta
    heading="Tell us who you need."
    body="Free 30-minute call on Google Meet. We confirm the right developers for your stack and send a monthly price."
    showAddress={false}
  />
</Base>

<style>
  /* Role chips slide in one after another, then drift gently */
  /* chip-in moves `translate` and chip-float moves `transform`, so the two don't cancel out */
  :global(.js-motion) .team-chip { animation: chip-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both, chip-float 5s ease-in-out infinite; animation-delay: calc(var(--i) * 0.15s + 0.3s), calc(var(--i) * -1.2s); }
  @keyframes chip-in { from { opacity: 0; translate: 24px 0; } }
  @keyframes chip-float { 50% { transform: translateY(-3px); } }
</style>
