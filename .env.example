# Copy to /var/www/armedias/.env on the server (never commit .env).

# Admin panel login at /admin/ (use a long, unique password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the SQLite database lives (outside release folders)
DATA_DIR=/var/www/armedias/data

# Supabase: leads and job applications. Settings -> API Keys. Use the SECRET key (sb_secret_...),
# server-only; never the publishable key and never the database password.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile secret key (server only). The public site key is in src/data/turnstile.ts.
TURNSTILE_SECRET_KEY=

# Contact form email notifications. Hostinger email SMTP shown as an example.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@armedias.com
SMTP_PASS=
CONTACT_TO=info@armedias.com
HOST=127.0.0.1
PORT=4321
